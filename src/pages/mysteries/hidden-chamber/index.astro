---
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="Hidden Chamber | First7 Play"
  description="A hidden scripture chamber within First7 Play, revealed through recovered mystery fragments."
>

  <section
    class="relative min-h-[78vh] overflow-hidden border-b border-[var(--color-border)]"
  >

    <div
      class="absolute inset-0 opacity-40"
      style="background: radial-gradient(circle at top center, rgba(214,179,106,0.1), transparent 58%);"
    ></div>

    <div
      class="absolute inset-x-0 top-24 h-px bg-gradient-to-r from-transparent via-[rgba(214,179,106,0.24)] to-transparent"
    ></div>

    <div
      class="relative mx-auto max-w-5xl px-5 py-28"
    >

      <div
        class="inline-flex rounded-full border border-[rgba(214,179,106,0.2)] bg-[rgba(214,179,106,0.07)] px-4 py-2 text-xs uppercase tracking-[0.18em] text-[var(--color-primary)]"
      >
        Archive Opened
      </div>

      <h1
        class="mt-8 max-w-4xl text-5xl font-semibold tracking-tight md:text-7xl"
      >
        The chamber remembers your fragments.
      </h1>

      <p
        class="mt-8 max-w-3xl text-lg leading-8 text-[var(--color-muted)]"
      >
        You found the threshold beneath the mysteries.
        What was sealed has not fully spoken,
        but the first door has answered.
      </p>

      <div
        class="mt-16 max-w-3xl rounded-3xl border border-[rgba(214,179,106,0.16)] bg-[rgba(255,255,255,0.025)] p-8 shadow-[0_0_44px_rgba(214,179,106,0.06)]"
      >

        <div
          class="text-sm uppercase tracking-[0.18em] text-[var(--color-primary)]"
        >
          Inscription
        </div>

        <p
          class="mt-6 text-2xl leading-10 text-[var(--color-text)]"
        >
          The lamp was not placed beneath the vessel.
          The seed was not buried without morning.
          The waiting was not empty.
        </p>

        <p
          class="mt-8 leading-8 text-[var(--color-muted)]"
        >
          Deeper records remain behind quieter seals.
          Return with what is recovered,
          and the archive will continue to unfold.
        </p>

      </div>

      <div
        class="mt-12 flex flex-wrap gap-4"
      >

        <a
          href="/mysteries"
          class="inline-flex items-center justify-center rounded-2xl border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-7 py-4 text-sm font-medium text-[var(--color-primary)] transition-all duration-300 hover:border-[rgba(214,179,106,0.34)] hover:bg-[rgba(214,179,106,0.14)]"
        >
          Return To Mysteries
        </a>

        <a
          href="/games"
          class="inline-flex items-center justify-center rounded-2xl border border-[var(--color-border)] px-7 py-4 text-sm font-medium text-[var(--color-muted)] transition-all duration-300 hover:border-[rgba(255,255,255,0.18)] hover:text-[var(--color-text)]"
        >
          Seek More Puzzles
        </a>

      </div>

    </div>

  </section>

</Layout>
