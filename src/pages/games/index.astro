---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";

const games =
  await getCollection("games");

const getGamePath = (id: string) =>
  id
    .replace(/(^|\/)index$/, "")
    .split("/")
    .filter(Boolean)
    .join("/");
---

<Layout
  title="Games — First7 Play"
  description="Interactive scripture games and mystery experiences."
>

  <Navbar />

  <main class="container py-16">

    <div class="max-w-3xl">

      <h1 class="text-5xl font-semibold tracking-tight">
        Games
      </h1>

      <p class="mt-6 text-lg leading-8 text-[var(--color-muted)]">
        Explore interactive scripture puzzles, mysteries,
        and discovery experiences.
      </p>

    </div>

    <section class="mt-16 grid gap-6">

      {games.map((game) => (

        <a
          href={`/games/${getGamePath(game.id)}`}
          class="card p-6 transition duration-200 hover:border-white/20"
        >

          <div class="flex items-center justify-between gap-4">

            <div>

              <h2 class="text-2xl font-semibold tracking-tight">
                {game.data.title}
              </h2>

              <p class="mt-3 text-[var(--color-muted)]">
                {game.data.description}
              </p>

            </div>

            <div class="text-sm text-[var(--color-primary)]">
              Play
            </div>

          </div>

        </a>

      ))}

    </section>

  </main>

</Layout>
