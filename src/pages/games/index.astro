---
import Layout from "../../layouts/Layout.astro";

const gameCategories = [
  {
    title: "Connections",

    description:
      "Discover hidden relationships between scripture themes, symbols, teachings, and ideas.",

    href: "/games/connections",

    badge: "Popular",

    difficulty: "Medium"
  },

  {
    title: "Sequence",

    description:
      "Arrange journeys, spiritual growth, scripture themes, and events into the correct order.",

    href: "/games/sequence",

    badge: "New",

    difficulty: "Easy"
  },

  {
    title: "Matching",

    description:
      "Match scripture meanings, verses, symbols, and spiritual ideas.",

    href: "/games/matching",

    badge: "Coming Soon",

    difficulty: "Easy"
  }
];
---

<Layout
  title="Bible Puzzle Games & Interactive Scripture Challenges | First7 Play"
  description="Explore Bible puzzle games, scripture challenges, Christian sequence games, Bible matching games, and interactive faith-based puzzle experiences."
>

  <!-- HERO -->

  <section
    class="border-b border-[var(--color-border)]"
  >

    <div
      class="mx-auto max-w-6xl px-5 py-24"
    >

      <div class="max-w-3xl">

        <div
          class="mb-6 inline-flex rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-4 py-2 text-xs uppercase tracking-[0.18em] text-[var(--color-primary)]"
        >
          Explore Games
        </div>

        <h1
          class="text-5xl font-semibold tracking-tight md:text-6xl"
        >
          Interactive Bible Games
          and Scripture Puzzles
        </h1>

        <p
          class="mt-8 text-lg leading-8 text-[var(--color-muted)]"
        >
          Explore scripture-based puzzle experiences
          designed around discovery, reflection,
          hidden meaning, memory, and progression.
        </p>

      </div>

    </div>

  </section>

  <!-- GAME GRID -->

  <section
    class="mx-auto max-w-6xl px-5 py-20"
  >

    <div
      class="grid gap-6 md:grid-cols-2 xl:grid-cols-3"
    >

      {
        gameCategories.map((game) => (

          <a
            href={game.href}
            class="group rounded-3xl border border-[var(--color-border)] bg-[rgba(255,255,255,0.02)] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[rgba(214,179,106,0.2)] hover:bg-[rgba(255,255,255,0.04)]"
          >

            <div
              class="flex items-center justify-between"
            >

              <div
                class="inline-flex rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-3 py-1 text-xs uppercase tracking-[0.18em] text-[var(--color-primary)]"
              >
                {game.badge}
              </div>

              <div
                class="text-xs uppercase tracking-[0.14em] text-[var(--color-muted)]"
              >
                {game.difficulty}
              </div>

            </div>

            <h2
              class="mt-8 text-3xl font-semibold tracking-tight"
            >
              {game.title}
            </h2>

            <p
              class="mt-5 leading-8 text-[var(--color-muted)]"
            >
              {game.description}
            </p>

            <div
              class="mt-8 text-sm text-[var(--color-primary)] transition-transform duration-300 group-hover:translate-x-1"
            >
              Explore →
            </div>

          </a>

        ))
      }

    </div>

  </section>

  <!-- SEO -->

  <section
    class="mx-auto max-w-4xl px-5 pb-24"
  >

    <div class="prose prose-invert max-w-none">

      <h2>
        Bible Puzzle Games and Interactive Scripture Challenges
      </h2>

      <p>
        First7 Play offers interactive Bible games
        and scripture puzzle experiences designed around
        reflection, learning, progression, and discovery.
      </p>

      <p>
        Explore Bible sequence games,
        scripture matching puzzles,
        Christian connections games,
        and hidden mystery challenges.
      </p>

    </div>

  </section>

</Layout>