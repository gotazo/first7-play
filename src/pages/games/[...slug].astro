---
import {
  getCollection,
  render,
  type CollectionEntry
} from "astro:content";

import {
  getGameSlug,
  getGameUrl
} from "../../lib/getGameUrl";

import Layout
  from "../../layouts/Layout.astro";

import ConnectionsGame
  from "../../components/games/ConnectionsGame.astro";

import MatchingGame
  from "../../components/games/MatchingGame.astro";

import SequenceGame
  from "../../components/games/SequenceGame.astro";

type GameEntry =
  CollectionEntry<"games">;

interface Props {
  game: GameEntry;
}

const gameEngines = {
  connections: ConnectionsGame,
  matching: MatchingGame,
  sequence: SequenceGame
};

export async function getStaticPaths() {

  const games =
    await getCollection("games");

  return games.map((game) => {

    const slug =
      getGameSlug(game.id);

    return {

      params: {
        slug
      },

      props: {
        game
      }

    };
  });
}

const { game } =
  Astro.props as Props;

const { Content } =
  await render(game);

const GameComponent =
  gameEngines[game.data.engine];
---

<Layout
  title={`${game.data.title} - First7 Play`}
  description={game.data.description}
>

  <main class="container py-16">

    <div class="max-w-3xl">

      <div
        class="text-sm uppercase tracking-[0.2em] text-[var(--color-primary)]"
      >
        {game.data.difficulty}
      </div>

      <h1
        class="mt-4 text-4xl md:text-5xl font-semibold tracking-tight"
      >
        {game.data.title}
      </h1>

      <p
        class="mt-6 text-lg leading-8 text-[var(--color-muted)]"
      >
        {game.data.description}
      </p>

    </div>

    <section class="mt-16">

      {
        GameComponent ? (

          <GameComponent
            puzzles={game.data.puzzles}
            gameId={game.id}
          />

        ) : (

          <p>
            Unknown game engine.
          </p>

        )
      }

    </section>

    <section class="mt-20 max-w-3xl">

      <div class="prose prose-invert">

        <Content />

        {
          game.data.nextPuzzle && (

            <div class="mt-16">

              <a
                href={getGameUrl(game.data.nextPuzzle)}
                class="inline-flex rounded-xl border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-6 py-4 text-sm text-[var(--color-primary)] transition-all duration-300 hover:border-[rgba(214,179,106,0.32)] hover:bg-[rgba(214,179,106,0.12)]"
              >
                Continue To Next Puzzle &rarr;
              </a>

            </div>

          )
        }

      </div>

    </section>

  </main>

</Layout>
