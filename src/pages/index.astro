---
import {
  getCollection
} from "astro:content";

import Layout from "../layouts/Layout.astro";

import {
  getGameUrl
} from "../lib/getGameUrl";

import {
  sortGamesByTitle
} from "../lib/sortGames";

const titleCase = (value: string) =>
  value.charAt(0).toUpperCase() +
  value.slice(1);

const games =
  sortGamesByTitle(
    await getCollection("games")
  );

const featuredEntries =
  games.filter((game) =>
    game.data.featured
  );

const featuredGames =
  (featuredEntries.length
    ? featuredEntries
    : games
  ).slice(0, 3).map((game) => ({
    title: game.data.title,
    description: game.data.description,
    href: getGameUrl(game.id),
    badge: titleCase(game.data.engine),
    difficulty: titleCase(game.data.difficulty),
    status: "Available"
  }));

const now = new Date();

const startOfYear =
  new Date(
    now.getFullYear(),
    0,
    0
  );

const dayNumber =
  Math.floor(
    (
      now.getTime() -
      startOfYear.getTime()
    ) / (
      1000 * 60 * 60 * 24
    )
  );

const dailyEntry =
  games[
    dayNumber %
    games.length
  ];

const dailyPuzzle = {
  title: dailyEntry.data.title,
  description: dailyEntry.data.description,
  href: getGameUrl(dailyEntry.id),
  badge: `${titleCase(dailyEntry.data.engine)} Puzzle`
};
