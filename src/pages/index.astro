---
import {
  getCollection
} from "astro:content";

import Layout from "../layouts/Layout.astro";

import {
  getGameUrl
} from "../lib/getGameUrl";

import {
  sortGamesByTitle
} from "../lib/sortGames";

const titleCase = (value: string) =>
  value.charAt(0).toUpperCase() +
  value.slice(1);

const games =
  sortGamesByTitle(
    await getCollection("games")
  );

const featuredEntries =
  games.filter((game) =>
    game.data.featured
  );

const featuredGames =
  (featuredEntries.length
    ? featuredEntries
    : games
  ).slice(0, 3).map((game) => ({
    title: game.data.title,
    description: game.data.description,
    href: getGameUrl(game.id),
    badge: titleCase(game.data.engine),
    difficulty: titleCase(game.data.difficulty),
    status: "Available"
  }));

const now = new Date();

const startOfYear =
  new Date(
    now.getFullYear(),
    0,
    0
  );

const dayNumber =
  Math.floor(
    (
      now.getTime() -
      startOfYear.getTime()
    ) / (
      1000 * 60 * 60 * 24
    )
  );

const dailyEntry =
  games[
    dayNumber %
    games.length
  ];

const dailyPuzzle = {
  title: dailyEntry.data.title,
  description: dailyEntry.data.description,
  href: getGameUrl(dailyEntry.id),
  badge: `${titleCase(dailyEntry.data.engine)} Puzzle`
};
---

<Layout
  title="First7 Play - Interactive Bible Games & Daily Scripture Puzzles"
  description="Play daily Bible puzzles, scripture games, mystery experiences, sequence challenges, and interactive faith-based games designed around reflection and discovery."
>

  <!-- HERO -->

  <section
    class="relative overflow-hidden border-b border-[var(--color-border)]"
  >

    <!-- BACKGROUND GLOW -->

    <div
      class="absolute inset-0"
      aria-hidden="true"
    >

      <div
        class="absolute left-1/2 top-0 h-[700px] w-[700px] -translate-x-1/2 rounded-full bg-[rgba(214,179,106,0.08)] blur-3xl"
      ></div>

      <div
        class="absolute inset-0 opacity-[0.04]"
        style="
          background-image:
            linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
          background-size: 60px 60px;
        "
      ></div>

    </div>

    <div
      class="relative mx-auto grid min-h-[92vh] max-w-7xl items-center gap-20 px-5 py-24 lg:grid-cols-[1.1fr_0.9fr]"
    >

      <!-- LEFT CONTENT -->

      <div>

        <div
          class="mb-6 inline-flex rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-4 py-2 text-xs uppercase tracking-[0.18em] text-[var(--color-primary)]"
        >
          Interactive Scripture Experiences
        </div>

        <h1
          class="max-w-3xl text-5xl font-semibold leading-tight tracking-tight md:text-7xl"
        >
          Discover Scripture Through
          <span class="text-[var(--color-primary)]">
            Mystery,
          </span>
          Progression,
          and Interactive Play.
        </h1>

        <p
          class="mt-8 max-w-2xl text-lg leading-8 text-[var(--color-muted)] md:text-xl"
        >
          Explore immersive Bible games, hidden puzzles,
          scripture mysteries, and daily interactive experiences
          designed around reflection, discovery, and spiritual progression.
        </p>

        <!-- CTA -->

        <div
          class="mt-10 flex flex-col gap-4 sm:flex-row"
        >

          <a
            href={dailyPuzzle.href}
            class="inline-flex items-center justify-center rounded-2xl border border-[rgba(214,179,106,0.24)] bg-[rgba(214,179,106,0.12)] px-8 py-4 text-sm font-medium text-[var(--color-primary)] shadow-[0_0_40px_rgba(214,179,106,0.08)] transition-all duration-300 hover:-translate-y-0.5 hover:border-[rgba(214,179,106,0.38)] hover:bg-[rgba(214,179,106,0.18)]"
          >
            Play Today's Puzzle &rarr;
          </a>

          <a
            href="/games"
            class="inline-flex items-center justify-center rounded-2xl border border-[var(--color-border)] px-8 py-4 text-sm font-medium transition-all duration-300 hover:bg-[rgba(255,255,255,0.04)]"
          >
            Explore Games
          </a>

        </div>

        <!-- MINI STATS -->

        <div
          class="mt-14 flex flex-wrap gap-8 border-t border-[rgba(255,255,255,0.06)] pt-8"
        >

          <div>

            <div
              class="text-2xl font-semibold"
            >
              1300+
            </div>

            <div
              class="mt-1 text-sm text-[var(--color-muted)]"
            >
              Scripture Pages
            </div>

          </div>

          <div>

            <div
              class="text-2xl font-semibold"
            >
              Daily
            </div>

            <div
              class="mt-1 text-sm text-[var(--color-muted)]"
            >
              Puzzle Challenges
            </div>

          </div>

          <div>

            <div
              class="text-2xl font-semibold"
            >
              Mystery
            </div>

            <div
              class="mt-1 text-sm text-[var(--color-muted)]"
            >
              Progression System
            </div>

          </div>

        </div>

      </div>

      <!-- RIGHT VISUAL -->

      <div
        class="relative hidden lg:flex items-center justify-center"
      >

        <div
          class="relative aspect-square w-full max-w-[540px]"
        >

          <!-- OUTER GLOW -->

          <div
            class="absolute inset-0 rounded-full bg-[rgba(214,179,106,0.06)] blur-3xl"
          ></div>

          <!-- SVG VISUAL -->

          <svg
            viewBox="0 0 600 600"
            class="relative z-10 h-full w-full"
            fill="none"
          >

            <!-- CIRCLES -->

            <circle
              cx="300"
              cy="300"
              r="220"
              stroke="rgba(214,179,106,0.14)"
              stroke-width="1"
            />

            <circle
              cx="300"
              cy="300"
              r="160"
              stroke="rgba(214,179,106,0.1)"
              stroke-width="1"
            />

            <circle
              cx="300"
              cy="300"
              r="100"
              stroke="rgba(214,179,106,0.08)"
              stroke-width="1"
            />

            <!-- CONNECTION PATHS -->

            <path
              d="M180 220 L300 150 L420 240 L360 380 L220 420 L180 220"
              stroke="rgba(214,179,106,0.28)"
              stroke-width="2"
            />

            <!-- NODES -->

            <circle cx="180" cy="220" r="8" fill="#d6b36a" />
            <circle cx="300" cy="150" r="8" fill="#d6b36a" />
            <circle cx="420" cy="240" r="8" fill="#d6b36a" />
            <circle cx="360" cy="380" r="8" fill="#d6b36a" />
            <circle cx="220" cy="420" r="8" fill="#d6b36a" />

            <!-- CENTER -->

            <circle
              cx="300"
              cy="300"
              r="42"
              fill="rgba(214,179,106,0.12)"
              stroke="rgba(214,179,106,0.35)"
            />

            <text
              x="300"
              y="308"
              text-anchor="middle"
              fill="#d6b36a"
              font-size="18"
              letter-spacing="4"
            >
              F7
            </text>

          </svg>

        </div>

      </div>

    </div>

  </section>

  <!-- DAILY PUZZLE -->

  <section
    class="mx-auto max-w-6xl px-5 py-20"
  >

    <div
      class="mb-10 flex items-center justify-between"
    >

      <div>

        <p
          class="text-sm uppercase tracking-[0.18em] text-[var(--color-primary)]"
        >
          Daily Challenge
        </p>

        <h2
          class="mt-3 text-3xl font-semibold tracking-tight"
        >
          Today's Featured Puzzle
        </h2>

      </div>

    </div>

    <a
      href={dailyPuzzle.href}
      class="group block overflow-hidden rounded-3xl border border-[rgba(214,179,106,0.14)] bg-[rgba(214,179,106,0.05)] p-8 transition-all duration-300 hover:border-[rgba(214,179,106,0.3)] hover:bg-[rgba(214,179,106,0.08)]"
    >

      <div
        class="flex flex-col gap-10 md:flex-row md:items-center md:justify-between"
      >

        <div class="max-w-2xl">

          <div
            class="mb-4 inline-flex rounded-full border border-[rgba(214,179,106,0.18)] px-3 py-1 text-xs uppercase tracking-[0.18em] text-[var(--color-primary)]"
          >
            {dailyPuzzle.badge}
          </div>

          <h3
            class="text-3xl font-semibold tracking-tight"
          >
            {dailyPuzzle.title}
          </h3>

          <p
            class="mt-5 text-lg leading-8 text-[var(--color-muted)]"
          >
            {dailyPuzzle.description}
          </p>

        </div>

        <div>

          <div
            class="inline-flex rounded-2xl border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-6 py-4 text-sm text-[var(--color-primary)] transition-all duration-300 group-hover:bg-[rgba(214,179,106,0.14)]"
          >
            Start Puzzle &rarr;
          </div>

        </div>

      </div>

    </a>

  </section>

  <!-- GAME CATEGORIES -->

  <section
    class="mx-auto max-w-6xl px-5 pb-24"
  >

    <div class="mb-12">

      <p
        class="text-sm uppercase tracking-[0.18em] text-[var(--color-primary)]"
      >
        Explore
      </p>

      <h2
        class="mt-3 text-3xl font-semibold tracking-tight"
      >
        Explore Bible Puzzle Games
      </h2>

      <p
        class="mt-5 max-w-2xl text-lg leading-8 text-[var(--color-muted)]"
      >
        Play scripture-based puzzle games designed around
        memory, discovery, logic, spiritual reflection,
        and hidden progression.
      </p>

    </div>

    <div
      class="grid gap-6 md:grid-cols-2 xl:grid-cols-3"
    >

      {
        featuredGames.map((game) => (

          <a
            href={game.href}
            class="group relative overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[rgba(255,255,255,0.02)] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[rgba(214,179,106,0.2)] hover:bg-[rgba(255,255,255,0.04)]"
          >

            <!-- GLOW -->

            <div
              class="absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
              style="background: radial-gradient(circle at top right, rgba(214,179,106,0.08), transparent 45%);"
            ></div>

            <div class="relative z-10">

              <!-- TOP -->

              <div
                class="flex items-center justify-between gap-4"
              >

                <div
                  class="inline-flex rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-3 py-1 text-xs uppercase tracking-[0.18em] text-[var(--color-primary)]"
                >
                  {game.badge}
                </div>

                <div
                  class="text-xs uppercase tracking-[0.16em] text-[var(--color-muted)]"
                >
                  {game.difficulty}
                </div>

              </div>

              <!-- TITLE -->

              <h3
                class="mt-8 text-3xl font-semibold tracking-tight"
              >
                {game.title}
              </h3>

              <!-- DESCRIPTION -->

              <p
                class="mt-5 leading-8 text-[var(--color-muted)]"
              >
                {game.description}
              </p>

              <!-- STATUS -->

              <div
                class="mt-8 flex items-center justify-between"
              >

                <div
                  class={`rounded-full px-3 py-1 text-xs uppercase tracking-[0.14em] ${
                    game.status === "Available"
                      ? "border border-[rgba(74,222,128,0.18)] bg-[rgba(74,222,128,0.08)] text-[rgb(74,222,128)]"
                      : "border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.04)] text-[var(--color-muted)]"
                  }`}
                >
                  {game.status}
                </div>

                <div
                  class="text-sm text-[var(--color-primary)] transition-transform duration-300 group-hover:translate-x-1"
                >
                  Explore &rarr;
                </div>

              </div>

            </div>

          </a>

        ))
      }

    </div>

  </section>

  <!-- MYSTERY TEASER -->

  <section
    class="border-y border-[var(--color-border)] bg-[rgba(255,255,255,0.02)]"
  >

    <div
      class="mx-auto max-w-6xl px-5 py-24"
    >

      <div class="max-w-3xl">

        <p
          class="text-sm uppercase tracking-[0.18em] text-[var(--color-primary)]"
        >
          Hidden Progression
        </p>

        <h2
          class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl"
        >
          Some mysteries reveal themselves only after progress.
        </h2>

        <p
          class="mt-8 text-lg leading-8 text-[var(--color-muted)]"
        >
          Solve puzzles, uncover scripture fragments,
          unlock hidden chambers,
          and discover deeper layers of meaning.
        </p>

        <div
          class="mt-10 inline-flex rounded-2xl border border-dashed border-[rgba(214,179,106,0.18)] px-6 py-4 text-sm text-[var(--color-primary)]"
        >
          ??? Chamber Locked
        </div>

      </div>

    </div>

  </section>

  <!-- SEO CONTENT -->

  <section
    class="mx-auto max-w-4xl px-5 py-24"
  >

    <div class="prose prose-invert prose-neutral max-w-none">

      <h2>
        Interactive Bible Games and Daily Scripture Puzzles
      </h2>

      <p>
        First7 Play is an interactive Bible puzzle platform focused on
        scripture discovery, spiritual reflection,
        memory challenges, mystery progression,
        and daily faith-based puzzle experiences.
      </p>

      <p>
        Explore Bible sequence games,
        scripture matching challenges,
        Bible connections puzzles,
        and hidden mystery experiences designed around
        progression and discovery.
      </p>

      <p>
        New daily Bible games and interactive scripture challenges
        are continually added to encourage learning,
        reflection, and exploration.
      </p>

    </div>

  </section>

</Layout>
