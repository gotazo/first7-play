      opacity: 0.3;
    }

    50% {
      transform: translateY(-8px);
      opacity: 0.8;
    }

  }

  @media (prefers-reduced-motion: reduce) {

    .f7-scroll,
    .f7-nodes,
    .f7-stars,
    .f7-particles circle {
      animation: none;
    }

  }

</style>

