---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";

import InvestigationPanel
  from "../../components/mysteries/InvestigationPanel.astro";

export async function getStaticPaths() {

  const investigations =
    await getCollection(
      "investigations"
    );

  return investigations.map(
    (entry) => ({

      params: {
        slug: entry.id
      },

      props: {
        entry
      }

    })
  );

}

const { entry } = Astro.props;

const {
  title,
  fragment,
  nodes,
  solution,
  archiveNotes,
  scriptureHints
} = entry.data;
---

<Layout
  title={title}
  description={entry.data.description}
>

  <main class="container py-20">

    <InvestigationPanel
  title={title}
  fragment={fragment}
  nodes={nodes}
  solution={solution}
  archiveNotes={archiveNotes}
  scriptureHints={scriptureHints}
/>

  </main>

</Layout>