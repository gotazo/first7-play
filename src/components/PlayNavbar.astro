---
import DarkToggle from "./DarkToggle.astro";

const pathname = Astro.url.pathname;

const links = [
  {
    href: "/daily",
    label: "Daily"
  },

  {
    href: "/quiz",
    label: "Quiz"
  },
  
  {
    href: "/games",
    label: "Games"
  },

  {
    href: "/mysteries",
    label: "Mysteries"
  },

  {
    href: "/investigations",
    label: "Investigations"
  }
];
---

<nav
  class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-xl"
>

  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-5"
  >

    <!-- LOGO -->

    <a
      href="/"
      class="flex min-w-0 items-center gap-2 tracking-tight"
    >

      <span
        class="shrink-0 text-2xl sm:text-3xl"
        style="font-family: 'Playfair Display', serif;"
      >
        first
      </span>

      <span
        class="shrink-0 text-2xl text-[var(--color-primary)] sm:text-3xl"
      >
        7
      </span>

      <span
        class="hidden rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-2 py-[4px] text-[10px] uppercase tracking-[0.18em] text-[var(--color-primary)] sm:inline-flex"
      >
        Play
      </span>

    </a>

    <!-- DESKTOP/TABLET NAV -->

    <div
      class="hidden items-center gap-5 lg:flex xl:gap-8"
    >

      {
        links.map((link) => {

          const isActive =
            pathname.startsWith(link.href);

          return (

            <a
              href={link.href}
              class={`text-sm transition-colors duration-200 ${
                isActive
                  ? "text-[var(--color-text)]"
                  : "text-[var(--color-muted)] hover:text-[var(--color-text)]"
              }`}
            >
              {link.label}
            </a>

          );
        })
      }

    </div>

    <!-- RIGHT -->

    <div
      class="flex items-center gap-2 sm:gap-3"
    >

      <a
        href="https://first7.org"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden text-sm text-[var(--color-muted)] transition hover:text-[var(--color-text)] xl:inline-flex"
      >
        Main Site ↗
      </a>

      <DarkToggle />

      <!-- MOBILE/TABLET MENU BUTTON -->

      <button
        id="menu-btn"
        aria-label="Open menu"
        class="inline-flex rounded-xl border border-[var(--color-border)] p-2 transition hover:bg-[rgba(255,255,255,0.04)] lg:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>

    </div>

  </div>

  <!-- MOBILE/TABLET MENU -->

  <div
    id="mobile-menu"
    class="hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur-xl lg:hidden"
  >

    <div
      class="mx-auto max-w-7xl space-y-2 px-4 py-5 sm:px-5"
    >

      {
        links.map((link) => {

          const isActive =
            pathname.startsWith(link.href);

          return (

            <a
              href={link.href}
              class={`block rounded-2xl px-4 py-3 text-sm transition ${
                isActive
                  ? "border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] text-[var(--color-text)]"
                  : "text-[var(--color-muted)] hover:bg-[rgba(255,255,255,0.04)] hover:text-[var(--color-text)]"
              }`}
            >
              {link.label}
            </a>

          );
        })
      }

      <a
        href="https://first7.org"
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-2xl px-4 py-3 text-sm text-[var(--color-muted)] transition hover:bg-[rgba(255,255,255,0.04)] hover:text-[var(--color-text)]"
      >
        Main Site ↗
      </a>

    </div>

  </div>

</nav>

<script is:inline>

  document.addEventListener(
    "DOMContentLoaded",
    () => {

      const btn =
        document.getElementById(
          "menu-btn"
        );

      const menu =
        document.getElementById(
          "mobile-menu"
        );

      btn?.addEventListener(
        "click",
        () => {

          menu?.classList.toggle(
            "hidden"
          );

        }
      );

    }
  );

</script>