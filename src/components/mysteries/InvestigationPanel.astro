---
interface Node {
  id: string;
  label: string;
  scripture: string;
  note: string;
}

interface Props {
  title: string;
  fragment: string;
  scene?: "temple" | "wilderness" | "dream" | "scroll";
  nodes: Node[];
  solution: string[];

  archiveNotes: string[];
  scriptureHints: string[];
}

import DreamScene from "./scenes/DreamScene.astro";
import ScrollScene from "./scenes/ScrollScene.astro";
import TempleScene from "./scenes/TempleScene.astro";
import WildernessScene from "./scenes/WildernessScene.astro";

const {
  title,
  fragment,
  scene = "temple",
  nodes,
  solution,
  archiveNotes,
  scriptureHints
} = Astro.props as Props;

const sceneComponents = {
  temple: TempleScene,
  wilderness: WildernessScene,
  dream: DreamScene,
  scroll: ScrollScene
};

const SceneComponent =
  sceneComponents[scene] || TempleScene;
---

<section class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-8 xl:grid-cols-[minmax(0,1fr)_400px]">

  <!-- INVESTIGATION SPACE -->

  <div class="flex flex-col gap-5 lg:gap-8">

    <div class="order-1 space-y-3 sm:space-y-5">

      <div class="inline-flex rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-3 py-1.5 text-[10px] uppercase tracking-[0.2em] text-[var(--color-primary)] sm:px-4 sm:py-2 sm:text-[11px]">
        Investigation Archive
      </div>

      <h1 class="text-3xl font-semibold tracking-tight md:text-5xl">
        {title}
      </h1>

    </div>

    <div class="order-3 grid gap-3 sm:gap-5 xl:grid-cols-[1fr_0.85fr]">

      <!-- ARCHIVE NOTES -->

      <div class="rounded-2xl border border-[rgba(214,179,106,0.07)] bg-[rgba(255,255,255,0.015)] p-4 sm:rounded-[24px] sm:p-6">

        <div class="mb-3 text-[11px] uppercase tracking-[0.2em] text-[var(--color-primary)] sm:mb-4 sm:text-xs sm:tracking-[0.22em]">
          Archive Notes
        </div>

        <div class="space-y-2.5 sm:space-y-3">

          {
            archiveNotes.map((note) => (

              <blockquote class="border-l border-[rgba(214,179,106,0.14)] pl-4 text-sm leading-6 text-[var(--color-muted)] sm:pl-5 sm:text-[15px] sm:leading-7">
                {note}
              </blockquote>

            ))
          }

        </div>

      </div>

      <!-- SCRIPTURE HINTS -->

      <div class="rounded-2xl border border-[rgba(214,179,106,0.07)] bg-[rgba(255,255,255,0.015)] p-4 sm:rounded-[24px] sm:p-6">

        <div class="mb-3 text-[11px] uppercase tracking-[0.2em] text-[var(--color-primary)] sm:mb-4 sm:text-xs sm:tracking-[0.22em]">
          Scripture Hints
        </div>

        <div class="flex flex-wrap gap-2 sm:gap-3">

          {
            scriptureHints.map((hint) => (

              <div class="rounded-full border border-[rgba(214,179,106,0.12)] bg-[rgba(214,179,106,0.05)] px-3 py-1.5 text-xs text-[var(--color-muted)] sm:px-4 sm:py-2 sm:text-sm">
                {hint}
              </div>

            ))
          }

        </div>

      </div>

    </div>

    <div class="order-2 overflow-hidden rounded-2xl border border-[rgba(214,179,106,0.08)] bg-[rgba(255,255,255,0.02)] p-2.5 sm:rounded-[28px] sm:p-5 md:p-8">

      <SceneComponent />

    </div>

  </div>

  <!-- ARCHIVE CONSOLE -->

  <aside class="lg:sticky lg:top-24 lg:self-start">

    <div class="space-y-4 rounded-2xl border border-[rgba(214,179,106,0.08)] bg-[rgba(255,255,255,0.02)] p-4 sm:space-y-6 sm:rounded-[28px] sm:p-6 md:p-8">

      <div>

        <div class="text-[11px] uppercase tracking-[0.2em] text-[var(--color-primary)] sm:text-xs sm:tracking-[0.22em]">
          Archive Console
        </div>

        <div class="mt-2 text-sm leading-6 text-[var(--color-muted)] sm:mt-3 sm:leading-7">
          Read the evidence, then test the symbols in sequence.
        </div>

      </div>

      <div class="h-px bg-[rgba(214,179,106,0.08)]"></div>

      <!-- ARCHIVE PROTOCOL -->

      <div>

        <div class="mb-2 text-[11px] uppercase tracking-[0.2em] text-[var(--color-primary)] sm:mb-3 sm:text-xs sm:tracking-[0.22em]">
          Archive Protocol
        </div>

        <div class="space-y-1.5 text-sm leading-6 text-[var(--color-muted)] sm:space-y-2 sm:text-[15px] sm:leading-7">

          <p>
            Investigate the symbols in their proper sequence.
          </p>

          <p>
            Recovered notes and scripture hints may reveal the hidden order.
          </p>

          <p>
            Incorrect paths fade without revelation.
          </p>

        </div>

      </div>

      <div class="h-px bg-[rgba(214,179,106,0.08)]"></div>

      <!-- SELECTED SYMBOL -->

      <div class="space-y-4 sm:space-y-5">

        <div class="text-[11px] uppercase tracking-[0.2em] text-[var(--color-primary)] sm:text-xs sm:tracking-[0.22em]">
          Investigation Notes
        </div>

        <div>

          <div class="text-[11px] uppercase tracking-[0.22em] text-[var(--color-muted)]">
            Selected Symbol
          </div>

          <div
            id="archive-label"
            class="mt-2 text-xl font-semibold sm:mt-3 sm:text-2xl"
          >
            Select A Symbol
          </div>

          <div
            id="archive-scripture"
            class="mt-3 text-sm text-[var(--color-primary)]"
          >
            Scripture reference will appear here.
          </div>

        </div>

        <blockquote
          id="archive-note"
          class="border-l border-[rgba(214,179,106,0.18)] pl-4 text-sm leading-6 text-[var(--color-muted)] sm:pl-5 sm:text-[15px] sm:leading-7"
        >
          Investigate the symbols to recover hidden fragments.
        </blockquote>

      </div>

      <div class="h-px bg-[rgba(214,179,106,0.08)]"></div>

      <!-- RECOVERY FEEDBACK -->

      <div>

        <div class="mb-2 text-[11px] uppercase tracking-[0.2em] text-[var(--color-primary)] sm:mb-3 sm:text-xs sm:tracking-[0.22em]">
          Recovery Feedback
        </div>

        <div
          id="recovery-status"
          class="rounded-2xl border border-[rgba(214,179,106,0.08)] bg-[rgba(255,255,255,0.02)] px-4 py-3 text-sm text-[var(--color-muted)] sm:px-5 sm:py-4"
        >
          Awaiting investigation...
        </div>

      </div>

    </div>

  </aside>

</section>

<style>

  :global(.investigation-scene) {
    display: block;
    height: auto;
    max-height: min(68vh, 620px);
    min-height: 280px;

    filter:
      drop-shadow(0 0 40px rgba(214,179,106,0.03));
  }

  :global(.investigation-node) {
    cursor: pointer;
    transition: all 0.35s ease;
    transform-origin: center;
    opacity: 0.82;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  :global(.investigation-node .node-hit-area) {
    fill: rgba(255, 255, 255, 0);
    pointer-events: all;
    stroke: transparent;
  }

  :global(.investigation-node:hover) {
    filter:
      drop-shadow(0 0 12px rgba(214,179,106,0.45));

    transform: scale(1.04);

    opacity: 1;
  }

  :global(.investigation-node.is-active) {
    filter:
      drop-shadow(0 0 14px rgba(214,179,106,0.34));

    opacity: 1;
  }

  :global(.investigation-node.is-active *) {
    stroke-opacity: 1;
  }

  :global(.investigation-node.is-fading) {
    filter:
      drop-shadow(0 0 4px rgba(214,179,106,0.12));

    opacity: 0.46;
  }

  @media (max-width: 640px) {

    :global(.investigation-scene) {
      width: 112%;
      max-width: none;
      margin-inline: -6%;
      min-height: 250px;
      max-height: 54vh;
    }

    :global(.investigation-node) {
      opacity: 0.95;
    }
  }

</style>

<script
  is:inline
  define:vars={{
    title,
    nodes,
    solution,
    fragment
  }}
>

  const archiveLabel =
    document.getElementById(
      'archive-label'
    );

  const archiveScripture =
    document.getElementById(
      'archive-scripture'
    );

  const archiveNote =
    document.getElementById(
      'archive-note'
    );

  const recoveryStatus =
    document.getElementById(
      'recovery-status'
    );

  const clickedSequence = [];

  let isResolving =
    false;

  let isRecovered =
    false;

  const svgNodes =
    document.querySelectorAll(
      '.investigation-node'
    );

  function updateArchive(nodeId) {

    const match =
      nodes.find(
        (node) => node.id === nodeId
      );

    if (!match) return;

    archiveLabel.textContent =
      match.label;

    archiveScripture.textContent =
      match.scripture;

    archiveNote.textContent =
      match.note;

  }

  function escapeAttribute(value) {

    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('"', '&quot;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;');

  }

  function setRecoveryStatus(
    message,
    tone = 'muted'
  ) {

    const toneClass =
      tone === 'primary'
        ? 'text-[var(--color-primary)]'
        : 'text-[var(--color-muted)]';

    recoveryStatus.textContent =
      message;

    recoveryStatus.className =
      `rounded-2xl border border-[rgba(214,179,106,0.08)] bg-[rgba(255,255,255,0.02)] px-5 py-4 text-sm ${toneClass}`;

    recoveryStatus.animate(
      [
        {
          opacity: 0.55,
          transform: 'translateY(2px)'
        },

        {
          opacity: 1,
          transform: 'translateY(0)'
        }
      ],
      {
        duration: 360,
        easing: 'ease-out'
      }
    );

  }

  function clearActiveNodes() {

    svgNodes.forEach((node) => {

      node.classList.remove(
        'is-active',
        'is-fading'
      );

    });

  }

  function fadeAttempt() {

    svgNodes.forEach((node) => {

      if (
        node.classList.contains(
          'is-active'
        )
      ) {

        node.classList.add(
          'is-fading'
        );

      }

    });

  }

  function resetAttempt() {

    clickedSequence.length = 0;

    clearActiveNodes();

    isResolving = false;

  }

  function isCurrentPathPossible() {

    return clickedSequence.every(
      (nodeId, index) =>
        solution[index] === nodeId
    );

  }

  function acknowledgeProgress() {

    if (
      clickedSequence.length === 1
    ) {

      setRecoveryStatus(
        'The archive responds...',
        'primary'
      );

      return;

    }

    setRecoveryStatus(
      'A hidden pattern begins to emerge...',
      'primary'
    );

  }

  function handleFadedSequence() {

    isResolving = true;

    setRecoveryStatus(
      'The sequence faded without revelation.'
    );

    fadeAttempt();

    window.setTimeout(
      resetAttempt,
      900
    );

  }

  function checkSolution() {

    if (!isCurrentPathPossible()) {

      handleFadedSequence();

      return;

    }

    if (
      clickedSequence.length === solution.length &&
      clickedSequence.slice(-solution.length)
        .join(",")
      ===
      solution.join(",")
    ) {

      isRecovered = true;

      recoveryStatus.innerHTML = `

        <div class="space-y-5">

          <div>
            Fragment recovered - ${fragment}
          </div>

          <div
            class="inline-flex rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-4 py-2 text-xs uppercase tracking-[0.22em] text-[var(--color-primary)]"
          >
            Archive Seal Broken
          </div>

          <button
            id="share-discovery"
            class="inline-flex items-center rounded-xl border border-[rgba(214,179,106,0.12)] bg-[rgba(255,255,255,0.02)] px-4 py-2.5 text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] transition duration-300 hover:border-[rgba(214,179,106,0.24)] hover:text-[var(--color-primary)]"
            data-share-title="First7 Play Archive Discovery"
            data-share-message="${escapeAttribute(`Recovered Archive Fragment:\n${fragment}\n\n'${archiveNote.textContent}'\n\n${title}\nFirst7 Play - transmitted from the recovered archive.`)}"
          >
            Share Discovery
          </button>

        </div>

      `;

      recoveryStatus.animate(
        [
          {
            opacity: 0.4,
            transform: 'scale(0.98)'
          },

          {
            opacity: 1,
            transform: 'scale(1)'
          }
        ],
        {
          duration: 700,
          easing: 'ease-out'
        }
      );

      recoveryStatus.className =
        'rounded-2xl border border-[rgba(214,179,106,0.22)] bg-[rgba(214,179,106,0.08)] px-5 py-4 text-sm text-[var(--color-primary)]';

      localStorage.setItem(
        `fragment-${fragment}`,
        'recovered'
      );

      return;

    }

    acknowledgeProgress();


  }

  svgNodes.forEach((node) => {

    node.addEventListener(
      'click',
      () => {

        if (
          isResolving ||
          isRecovered
        ) return;

        const nodeId =
          node.dataset.node;

        if (!nodeId) return;

        clickedSequence.push(
          nodeId
        );

        node.classList.add(
          'is-active'
        );

        updateArchive(nodeId);

        checkSolution();

      }
    );

  });

</script>

<script>
  import { bindDiscoveryShareButtons } from '../../lib/shareDiscovery';

  bindDiscoveryShareButtons({
    selector: '#share-discovery'
  });
</script>

