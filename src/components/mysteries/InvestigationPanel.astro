---
interface Node {
  id: string;
  label: string;
  scripture: string;
  note: string;
}

interface Props {
  title: string;
  fragment: string;
  scene?: "temple" | "wilderness" | "dream" | "scroll";
  nodes: Node[];
  solution: string[];

  archiveNotes: string[];
  scriptureHints: string[];
}

import DreamScene from "./scenes/DreamScene.astro";
import ScrollScene from "./scenes/ScrollScene.astro";
import TempleScene from "./scenes/TempleScene.astro";
import WildernessScene from "./scenes/WildernessScene.astro";

const {
  title,
  fragment,
  scene = "temple",
  nodes,
  solution,
  archiveNotes,
  scriptureHints
} = Astro.props as Props;

const sceneComponents = {
  temple: TempleScene,
  wilderness: WildernessScene,
  dream: DreamScene,
  scroll: ScrollScene
};

const SceneComponent =
  sceneComponents[scene] || TempleScene;
---

<section class="space-y-10">

  <!-- HEADER -->

  <div class="space-y-5">

    <div class="inline-flex rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-4 py-2 text-[11px] uppercase tracking-[0.22em] text-[var(--color-primary)]">
      Investigation Archive
    </div>

    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">
      {title}
    </h1>

    <div class="max-w-2xl space-y-6">

      <!-- ARCHIVE NOTES -->

      <div>

        <div class="mb-3 text-xs uppercase tracking-[0.22em] text-[var(--color-primary)]">
          Archive Notes
        </div>

        <div class="space-y-3">

          {
            archiveNotes.map((note) => (

              <blockquote class="border-l border-[rgba(214,179,106,0.14)] pl-5 text-[15px] leading-7 text-[var(--color-muted)]">
                {note}
              </blockquote>

            ))
          }

        </div>

      </div>

      <!-- SCRIPTURE HINTS -->

      <div>

        <div class="mb-3 text-xs uppercase tracking-[0.22em] text-[var(--color-primary)]">
          Scripture Hints
        </div>

        <div class="flex flex-wrap gap-3">

          {
            scriptureHints.map((hint) => (

              <div class="rounded-full border border-[rgba(214,179,106,0.12)] bg-[rgba(214,179,106,0.05)] px-4 py-2 text-sm text-[var(--color-muted)]">
                {hint}
              </div>

            ))
          }

        </div>

      </div>

      <!-- ARCHIVE PROTOCOL -->

      <div class="rounded-2xl border border-[rgba(214,179,106,0.08)] bg-[rgba(255,255,255,0.02)] px-5 py-4">

        <div class="mb-3 text-xs uppercase tracking-[0.22em] text-[var(--color-primary)]">
          Archive Protocol
        </div>

        <div class="space-y-2 text-[15px] leading-7 text-[var(--color-muted)]">

          <p>
            Investigate the symbols in their proper sequence.
          </p>

          <p>
            Recovered notes and scripture hints may reveal the hidden order.
          </p>

          <p>
            Incorrect paths fade without revelation.
          </p>

        </div>

      </div>

    </div>

  </div>

  <!-- STATUS -->

  <div
    id="recovery-status"
    class="rounded-2xl border border-[rgba(214,179,106,0.08)] bg-[rgba(255,255,255,0.02)] px-5 py-4 text-sm text-[var(--color-muted)]"
  >
    Awaiting investigation...
  </div>

  <!-- PANEL -->

  <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">

    <!-- SCENE PANEL -->

    <div class="rounded-[28px] border border-[rgba(214,179,106,0.08)] bg-[rgba(255,255,255,0.02)] p-8">

      <SceneComponent />

    </div>

    <!-- ARCHIVE PANEL -->

    <div class="rounded-[28px] border border-[rgba(214,179,106,0.08)] bg-[rgba(255,255,255,0.02)] p-8">

      <div class="text-xs uppercase tracking-[0.22em] text-[var(--color-primary)]">
        Investigation Notes
      </div>

      <div class="mt-8 space-y-6">

        <div>

          <div
            id="archive-label"
            class="text-2xl font-semibold"
          >
            Select A Symbol
          </div>

          <div
            id="archive-scripture"
            class="mt-3 text-sm text-[var(--color-primary)]"
          >
            Scripture reference will appear here.
          </div>

        </div>

        <blockquote
          id="archive-note"
          class="border-l border-[rgba(214,179,106,0.18)] pl-5 text-[15px] leading-7 text-[var(--color-muted)]"
        >
          Investigate the symbols to recover hidden fragments.
        </blockquote>

      </div>

    </div>

  </div>

</section>

<style>

  :global(.investigation-scene) {
    filter:
      drop-shadow(0 0 40px rgba(214,179,106,0.03));
  }

  :global(.investigation-node) {
    cursor: pointer;
    transition: all 0.35s ease;
    transform-origin: center;
    opacity: 0.82;
  }

  :global(.investigation-node:hover) {
    filter:
      drop-shadow(0 0 12px rgba(214,179,106,0.45));

    transform: scale(1.04);

    opacity: 1;
  }

  :global(.investigation-node.is-active) {
    filter:
      drop-shadow(0 0 14px rgba(214,179,106,0.34));

    opacity: 1;
  }

  :global(.investigation-node.is-active *) {
    stroke-opacity: 1;
  }

  :global(.investigation-node.is-fading) {
    filter:
      drop-shadow(0 0 4px rgba(214,179,106,0.12));

    opacity: 0.46;
  }

</style>

<script
  is:inline
  define:vars={{
    title,
    nodes,
    solution,
    fragment
  }}
>

  const archiveLabel =
    document.getElementById(
      'archive-label'
    );

  const archiveScripture =
    document.getElementById(
      'archive-scripture'
    );

  const archiveNote =
    document.getElementById(
      'archive-note'
    );

  const recoveryStatus =
    document.getElementById(
      'recovery-status'
    );

  const clickedSequence = [];

  let isResolving =
    false;

  let isRecovered =
    false;

  const svgNodes =
    document.querySelectorAll(
      '.investigation-node'
    );

  function updateArchive(nodeId) {

    const match =
      nodes.find(
        (node) => node.id === nodeId
      );

    if (!match) return;

    archiveLabel.textContent =
      match.label;

    archiveScripture.textContent =
      match.scripture;

    archiveNote.textContent =
      match.note;

  }

  function escapeAttribute(value) {

    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('"', '&quot;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;');

  }

  function setRecoveryStatus(
    message,
    tone = 'muted'
  ) {

    const toneClass =
      tone === 'primary'
        ? 'text-[var(--color-primary)]'
        : 'text-[var(--color-muted)]';

    recoveryStatus.textContent =
      message;

    recoveryStatus.className =
      `rounded-2xl border border-[rgba(214,179,106,0.08)] bg-[rgba(255,255,255,0.02)] px-5 py-4 text-sm ${toneClass}`;

    recoveryStatus.animate(
      [
        {
          opacity: 0.55,
          transform: 'translateY(2px)'
        },

        {
          opacity: 1,
          transform: 'translateY(0)'
        }
      ],
      {
        duration: 360,
        easing: 'ease-out'
      }
    );

  }

  function clearActiveNodes() {

    svgNodes.forEach((node) => {

      node.classList.remove(
        'is-active',
        'is-fading'
      );

    });

  }

  function fadeAttempt() {

    svgNodes.forEach((node) => {

      if (
        node.classList.contains(
          'is-active'
        )
      ) {

        node.classList.add(
          'is-fading'
        );

      }

    });

  }

  function resetAttempt() {

    clickedSequence.length = 0;

    clearActiveNodes();

    isResolving = false;

  }

  function isCurrentPathPossible() {

    return clickedSequence.every(
      (nodeId, index) =>
        solution[index] === nodeId
    );

  }

  function acknowledgeProgress() {

    if (
      clickedSequence.length === 1
    ) {

      setRecoveryStatus(
        'The archive responds...',
        'primary'
      );

      return;

    }

    setRecoveryStatus(
      'A hidden pattern begins to emerge...',
      'primary'
    );

  }

  function handleFadedSequence() {

    isResolving = true;

    setRecoveryStatus(
      'The sequence faded without revelation.'
    );

    fadeAttempt();

    window.setTimeout(
      resetAttempt,
      900
    );

  }

  function checkSolution() {

    if (!isCurrentPathPossible()) {

      handleFadedSequence();

      return;

    }

    if (
      clickedSequence.length === solution.length &&
      clickedSequence.slice(-solution.length)
        .join(",")
      ===
      solution.join(",")
    ) {

      isRecovered = true;

      recoveryStatus.innerHTML = `

        <div class="space-y-5">

          <div>
            Fragment recovered - ${fragment}
          </div>

          <div
            class="inline-flex rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-4 py-2 text-xs uppercase tracking-[0.22em] text-[var(--color-primary)]"
          >
            Archive Seal Broken
          </div>

          <button
            id="share-discovery"
            class="inline-flex items-center rounded-xl border border-[rgba(214,179,106,0.12)] bg-[rgba(255,255,255,0.02)] px-4 py-2.5 text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] transition duration-300 hover:border-[rgba(214,179,106,0.24)] hover:text-[var(--color-primary)]"
            data-share-title="First7 Play Archive Discovery"
            data-share-message="${escapeAttribute(`Recovered Archive Fragment:\n${fragment}\n\n'${archiveNote.textContent}'\n\n${title}\nFirst7 Play - transmitted from the recovered archive.`)}"
          >
            Share Discovery
          </button>

        </div>

      `;

      recoveryStatus.animate(
        [
          {
            opacity: 0.4,
            transform: 'scale(0.98)'
          },

          {
            opacity: 1,
            transform: 'scale(1)'
          }
        ],
        {
          duration: 700,
          easing: 'ease-out'
        }
      );

      recoveryStatus.className =
        'rounded-2xl border border-[rgba(214,179,106,0.22)] bg-[rgba(214,179,106,0.08)] px-5 py-4 text-sm text-[var(--color-primary)]';

      localStorage.setItem(
        `fragment-${fragment}`,
        'recovered'
      );

      return;

    }

    acknowledgeProgress();


  }

  svgNodes.forEach((node) => {

    node.addEventListener(
      'click',
      () => {

        if (
          isResolving ||
          isRecovered
        ) return;

        const nodeId =
          node.dataset.node;

        if (!nodeId) return;

        clickedSequence.push(
          nodeId
        );

        node.classList.add(
          'is-active'
        );

        updateArchive(nodeId);

        checkSolution();

      }
    );

  });

</script>

<script>
  import { bindDiscoveryShareButtons } from '../../lib/shareDiscovery';

  bindDiscoveryShareButtons({
    selector: '#share-discovery'
  });
</script>

