---
const year = new Date().getFullYear();

const exploreLinks = [
  {
    href: "/daily",
    label: "Daily"
  },

  {
    href: "/quiz",
    label: "Quiz"
  },

  {
    href: "/games",
    label: "All Games"
  },

  {
    href: "/games/connections",
    label: "Connections"
  },

  {
    href: "/games/sequence",
    label: "Sequence"
  },

  {
    href: "/games/matching",
    label: "Matching"
  }
];

const mysteryLinks = [
  {
    href: "/mysteries",
    label: "Mysteries"
  },

  {
    href: "/investigations",
    label: "Investigations"
  },

  {
    href: "/investigations/temple-covenant",
    label: "Temple Covenant"
  },

  {
    href: "/mysteries/hidden-chamber",
    label: "Hidden Chamber"
  }
];

const infoLinks = [
  {
    href: "/privacy",
    label: "Privacy"
  },

  {
    href: "/terms",
    label: "Terms"
  }
];
---

<footer
  class="mt-24 border-t border-[var(--color-border)] bg-[var(--color-bg)]"
>

  <div
    class="mx-auto max-w-7xl px-4 py-16 sm:px-5"
  >

    <!-- TOP -->

    <div
      class="grid gap-14 md:grid-cols-2 xl:grid-cols-4"
    >

      <!-- BRAND -->

      <div class="xl:col-span-1">

        <a
          href="/"
          class="flex items-center gap-2 tracking-tight"
        >

          <span
            class="text-3xl"
            style="font-family: 'Playfair Display', serif;"
          >
            first
          </span>

          <span
            class="text-3xl text-[var(--color-primary)]"
          >
            7
          </span>

          <span
            class="rounded-full border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-2 py-[4px] text-[10px] uppercase tracking-[0.18em] text-[var(--color-primary)]"
          >
            Play
          </span>

        </a>

        <p
          class="mt-5 max-w-md text-sm leading-7 text-[var(--color-muted)]"
        >
          Interactive scripture experiences centered around
          reflection, discovery, mystery progression,
          hidden meaning, and daily exploration.
        </p>

        <a
          href="https://first7.org"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex text-sm text-[var(--color-primary)] transition hover:opacity-80"
        >
          Visit Main Site ↗
        </a>

      </div>

      <!-- EXPLORE -->

      <div>

        <p
          class="text-sm font-medium uppercase tracking-[0.14em] text-[var(--color-text)]"
        >
          Explore
        </p>

        <ul
          class="mt-5 space-y-3 text-sm"
        >

          {
            exploreLinks.map((link) => (

              <li>

                <a
                  href={link.href}
                  class="text-[var(--color-muted)] transition hover:text-[var(--color-text)]"
                >
                  {link.label}
                </a>

              </li>

            ))
          }

        </ul>

      </div>

      <!-- JOURNEY -->

      <div>

        <p
          class="text-sm font-medium uppercase tracking-[0.14em] text-[var(--color-text)]"
        >
          Journey
        </p>

        <ul
          class="mt-5 space-y-3 text-sm"
        >

          {
            mysteryLinks.map((link) => (

              <li>

                <a
                  href={link.href}
                  class="text-[var(--color-muted)] transition hover:text-[var(--color-text)]"
                >
                  {link.label}
                </a>

              </li>

            ))
          }

        </ul>

      </div>

      <!-- INFO -->

      <div>

        <p
          class="text-sm font-medium uppercase tracking-[0.14em] text-[var(--color-text)]"
        >
          Information
        </p>

        <ul
          class="mt-5 space-y-3 text-sm"
        >

          {
            infoLinks.map((link) => (

              <li>

                <a
                  href={link.href}
                  class="text-[var(--color-muted)] transition hover:text-[var(--color-text)]"
                >
                  {link.label}
                </a>

              </li>

            ))
          }

        </ul>

      </div>

    </div>

    <!-- BOTTOM -->

    <div
      class="mt-14 border-t border-[var(--color-border)] pt-8"
    >

      <div
        class="flex flex-col gap-4 text-sm text-[var(--color-muted)] md:flex-row md:items-center md:justify-between"
      >

        <p>
          © {year} First7 Play. All rights reserved.
        </p>

        <div
          class="flex flex-wrap items-center gap-5"
        >

          <a
            href="/privacy"
            class="transition hover:text-[var(--color-text)]"
          >
            Privacy
          </a>

          <a
            href="/terms"
            class="transition hover:text-[var(--color-text)]"
          >
            Terms
          </a>

          <a
            href="/quiz"
            class="transition hover:text-[var(--color-text)]"
          >
            Quiz
          </a>

          <a
            href="/games"
            class="transition hover:text-[var(--color-text)]"
          >
            Games
          </a>

        </div>

      </div>

    </div>

  </div>

</footer>