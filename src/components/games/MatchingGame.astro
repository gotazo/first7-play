---
interface Pair {
  left: string;
  right: string;
}

interface Puzzle {
  title: string;

  fragment?: string;

  scripture: {
    reference: string;
    verse: string;
  };

  pairs: Pair[];
}

const puzzles =
  Astro.props.puzzles as Puzzle[];

const puzzle = puzzles[0];

const leftItems =
  puzzle.pairs.map((pair) => pair.left);

const rightItems =
  [...puzzle.pairs]
    .map((pair) => pair.right)
    .sort(() => Math.random() - 0.5);
---

<div class="space-y-10">

  <!-- INTRO -->

  <div class="max-w-2xl space-y-3">

    <p
      class="text-sm uppercase tracking-[0.2em] text-[var(--color-primary)]"
    >
      Matching
    </p>

    <h2
      class="text-3xl font-semibold tracking-tight"
    >
      {puzzle.title}
    </h2>

    <p
      class="text-[var(--color-muted)] leading-7"
    >
      Match each spiritual concept
      with its correct scripture,
      meaning,
      or connection.
    </p>

  </div>

  <!-- STATUS -->

  <div
    class="flex flex-wrap items-center gap-4"
  >

    <div
      id="matches-count"
      class="rounded-full border border-[var(--color-border)] px-4 py-2 text-sm text-[var(--color-muted)]"
    >
      0 / {puzzle.pairs.length} matched
    </div>

  </div>

  <!-- GAME -->

  <div
    class="grid gap-6 md:grid-cols-2"
  >

    <!-- LEFT -->

    <div
      class="space-y-4"
    >

      {
        leftItems.map((item) => (

          <button
            class="left-card card w-full p-5 text-left transition duration-200 hover:border-white/20 hover:bg-[var(--color-surface-light)]"
            data-value={item}
          >
            {item}
          </button>

        ))
      }

    </div>

    <!-- RIGHT -->

    <div
      class="space-y-4"
    >

      {
        rightItems.map((item) => (

          <button
            class="right-card card w-full p-5 text-left transition duration-200 hover:border-white/20 hover:bg-[var(--color-surface-light)]"
            data-value={item}
          >
            {item}
          </button>

        ))
      }

    </div>

  </div>

  <!-- FEEDBACK -->

  <div
    id="feedback"
    class="min-h-[24px] text-sm"
  ></div>

</div>

<script is:inline define:vars={{ puzzle }}>

  let selectedLeft = null;

  let matchedCount = 0;

  const leftCards =
    document.querySelectorAll(
      '.left-card'
    );

  const rightCards =
    document.querySelectorAll(
      '.right-card'
    );

  const feedback =
    document.getElementById(
      'feedback'
    );

  const matchesCount =
    document.getElementById(
      'matches-count'
    );

  const FRAGMENTS_KEY =
    'first7-fragments';

  function unlockFragment(fragment) {

    if (!fragment) return;

    let fragments = [];

    try {

      const raw =
        localStorage.getItem(
          FRAGMENTS_KEY
        );

      fragments =
        raw ? JSON.parse(raw) : [];

      if (!Array.isArray(fragments)) {
        fragments = [];
      }

    } catch {

      fragments = [];

    }

    if (
      fragments.includes(fragment)
    ) return;

    fragments.push(fragment);

    localStorage.setItem(
      FRAGMENTS_KEY,
      JSON.stringify(fragments)
    );

  }

  function updateUI() {

    matchesCount.textContent =
      `${matchedCount} / ${puzzle.pairs.length} matched`;

  }

  function clearLeftSelection() {

    leftCards.forEach((card) => {

      card.classList.remove(
        'border-[var(--color-primary)]',
        'bg-[rgba(214,179,106,0.12)]',
        'text-[var(--color-primary)]'
      );

    });

  }

  function escapeAttribute(value) {

    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('"', '&quot;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;');

  }

  leftCards.forEach((card) => {

    card.addEventListener(
      'click',
      () => {

        if (card.disabled)
          return;

        clearLeftSelection();

        selectedLeft =
          card.dataset.value;

        card.classList.add(
          'border-[var(--color-primary)]',
          'bg-[rgba(214,179,106,0.12)]',
          'text-[var(--color-primary)]'
        );

      }
    );

  });

  rightCards.forEach((card) => {

    card.addEventListener(
      'click',
      () => {

        if (
          !selectedLeft ||
          card.disabled
        ) return;

        const selectedRight =
          card.dataset.value;

        const correctPair =
          puzzle.pairs.find(
            (pair) =>
              pair.left === selectedLeft
          );

        if (
          correctPair.right ===
          selectedRight
        ) {

          matchedCount++;

          feedback.textContent =
            '✓ Correct Match';

          feedback.className =
            'text-sm text-[var(--color-success)]';

          const activeLeft =
            Array.from(leftCards).find(
              (c) =>
                c.dataset.value ===
                selectedLeft
            );

          activeLeft.disabled = true;
          card.disabled = true;

          activeLeft.classList.add(
            'opacity-40',
            'pointer-events-none'
          );

          card.classList.add(
            'opacity-40',
            'pointer-events-none'
          );

        } else {

          feedback.textContent =
            'Not a correct match.';

          feedback.className =
            'text-sm text-[var(--color-danger)]';

        }

        selectedLeft = null;

        clearLeftSelection();

        updateUI();

        if (
          matchedCount ===
          puzzle.pairs.length
        ) {

          unlockFragment(
            puzzle.fragment
          );

          feedback.innerHTML = `

<div class="space-y-4">

  <div class="text-[var(--color-success)]">
    🎉 All matches completed.
  </div>

  <div class="card p-5 border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.06)]">

    <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] mb-3">
      Scripture Revealed
    </div>

    <blockquote class="text-sm leading-7 text-[var(--color-muted)]">
      “${puzzle.scripture.verse}”
    </blockquote>

    <div class="mt-3 text-sm text-[var(--color-primary)]">
      ${puzzle.scripture.reference}
    </div>

    <button
      type="button"
      class="share-discovery-btn mt-5 inline-flex items-center rounded-xl border border-[rgba(214,179,106,0.12)] bg-[rgba(255,255,255,0.02)] px-4 py-2.5 text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] transition duration-300 hover:border-[rgba(214,179,106,0.24)] hover:text-[var(--color-primary)]"
      data-share-title="First7 Play Recovered Meaning"
      data-share-message="${escapeAttribute(`Recovered Meaning:\n${puzzle.scripture.reference}\n'${puzzle.scripture.verse}'\n\nFirst7 Play - transmitted from the recovered archive.`)}"
    >
      Share Discovery
    </button>

  </div>

</div>

`;

        }

      }
    );

  });

  updateUI();

</script>

<script>
  import { bindDiscoveryShareButtons } from '../../lib/shareDiscovery';

  bindDiscoveryShareButtons({
    selector: '.share-discovery-btn'
  });
</script>
