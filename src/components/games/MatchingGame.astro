---
interface Puzzle {
  title: string;
  items: string[];
}

const puzzles = Astro.props.puzzles as Puzzle[];
---

<div class="grid gap-4">
  {puzzles.map((puzzle) => (
    <section class="card p-5">
      <h2 class="text-lg font-semibold tracking-tight">
        {puzzle.title}
      </h2>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {puzzle.items.map((item) => (
          <button class="rounded-md border border-white/10 p-4 text-left transition duration-200 hover:border-white/20 hover:bg-[var(--color-surface-light)]">
            {item}
          </button>
        ))}
      </div>
    </section>
  ))}
</div>
