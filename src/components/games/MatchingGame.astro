---
interface Pair {
  left: string;
  right: string;
}

interface Puzzle {
  title: string;

  fragment?: string;

  scripture: {
    reference: string;
    verse: string;
  };

  pairs: Pair[];
}

const puzzles =
  Astro.props.puzzles as Puzzle[];

const puzzle = puzzles[0];

const leftItems =
  puzzle.pairs.map((pair) => pair.left);

const rightItems =
  [...puzzle.pairs]
    .map((pair) => pair.right)
    .sort(() => Math.random() - 0.5);
---

<div class="space-y-6 sm:space-y-10">

  <!-- INTRO -->

  <div class="max-w-2xl space-y-2 sm:space-y-3">

    <p
      class="text-sm uppercase tracking-[0.2em] text-[var(--color-primary)]"
    >
      Matching
    </p>

    <h2
      class="text-2xl font-semibold tracking-tight sm:text-3xl"
    >
      {puzzle.title}
    </h2>

    <p
      class="text-sm leading-6 text-[var(--color-muted)] sm:text-base sm:leading-7"
    >
      Match each spiritual concept
      with its correct scripture,
      meaning,
      or connection.
    </p>

  </div>

  <!-- STATUS -->

  <div class="space-y-3">

    <div class="flex flex-wrap items-center gap-2 sm:gap-4">

      <div
        id="matches-count"
        class="rounded-full border border-[var(--color-border)] px-3 py-1.5 text-xs text-[var(--color-muted)] sm:px-4 sm:py-2 sm:text-sm"
        aria-live="polite"
      >
        0 / {puzzle.pairs.length} matched
      </div>

    </div>

    <!-- PROGRESS -->

    <div
      class="h-2 w-full overflow-hidden rounded-full bg-[rgba(255,255,255,0.06)]"
      role="progressbar"
      aria-label="Matching puzzle progress"
      aria-valuemin="0"
      aria-valuemax={puzzle.pairs.length}
      aria-valuenow="0"
      id="matches-progress"
    >
      <div
        id="matches-progress-fill"
        class="h-full rounded-full bg-[var(--color-primary)] transition-all duration-300"
        style="width: 0%"
      ></div>
    </div>

  </div>

  <!-- GAME -->

  <div class="grid grid-cols-2 gap-3 md:gap-6">

    <!-- LEFT -->

    <div class="space-y-2.5 sm:space-y-4">

      {leftItems.map((item) => (

        <button
          type="button"
          class="left-card card flex min-h-[52px] w-full items-center p-3 text-left text-sm leading-snug transition duration-200 hover:border-white/20 hover:bg-[var(--color-surface-light)] sm:min-h-[64px] sm:p-5 sm:text-base"
          data-value={item}
          aria-pressed="false"
        >
          <span class="card-content">{item}</span>
        </button>

      ))}

    </div>

    <!-- RIGHT -->

    <div class="space-y-2.5 sm:space-y-4">

      {rightItems.map((item) => (

        <button
          type="button"
          class="right-card card flex min-h-[52px] w-full items-center p-3 text-left text-sm leading-snug transition duration-200 hover:border-white/20 hover:bg-[var(--color-surface-light)] sm:min-h-[64px] sm:p-5 sm:text-base"
          data-value={item}
          aria-pressed="false"
        >
          <span class="card-content">{item}</span>
        </button>

      ))}

    </div>

  </div>

  <!-- FEEDBACK -->

  <div
    id="feedback"
    class="min-h-[28px] text-sm"
    aria-live="polite"
    aria-atomic="true"
  ></div>

</div>


<script is:inline define:vars={{ puzzle }}>

  let selectedLeft = null;

  let matchedCount = 0;

  const leftCards =
    document.querySelectorAll(
      '.left-card'
    );

  const rightCards =
    document.querySelectorAll(
      '.right-card'
    );

  const feedback =
    document.getElementById(
      'feedback'
    );

  const matchesCount =
    document.getElementById(
      'matches-count'
    );

  const progress =
    document.getElementById(
      'matches-progress'
    );

  const progressFill =
    document.getElementById(
      'matches-progress-fill'
    );

  const FRAGMENTS_KEY =
    'first7-fragments';


  /*
    ============================================================
    FRAGMENT REWARD
    ============================================================
  */

  function unlockFragment(fragment) {

    if (!fragment) return;

    let fragments = [];

    try {

      const raw =
        localStorage.getItem(
          FRAGMENTS_KEY
        );

      fragments =
        raw ? JSON.parse(raw) : [];

      if (!Array.isArray(fragments)) {
        fragments = [];
      }

    } catch {

      fragments = [];

    }

    if (
      fragments.includes(fragment)
    ) return;

    fragments.push(fragment);

    localStorage.setItem(
      FRAGMENTS_KEY,
      JSON.stringify(fragments)
    );

  }


  /*
    ============================================================
    PROGRESS
    ============================================================
  */

  function updateUI() {

    const total =
      puzzle.pairs.length;

    const percentage =
      total > 0
        ? (matchedCount / total) * 100
        : 0;

    matchesCount.textContent =
      `${matchedCount} / ${total} matched`;

    if (progress) {

      progress.setAttribute(
        'aria-valuenow',
        String(matchedCount)
      );

    }

    if (progressFill) {

      progressFill.style.width =
        `${percentage}%`;

    }

  }


  /*
    ============================================================
    SELECTION
    ============================================================
  */

  function clearLeftSelection() {

    leftCards.forEach((card) => {

      card.classList.remove(
        'border-[var(--color-primary)]',
        'bg-[rgba(214,179,106,0.12)]',
        'text-[var(--color-primary)]'
      );

      card.setAttribute(
        'aria-pressed',
        'false'
      );

    });

  }


  function selectLeftCard(card) {

    clearLeftSelection();

    selectedLeft =
      card.dataset.value;

    card.classList.add(
      'border-[var(--color-primary)]',
      'bg-[rgba(214,179,106,0.12)]',
      'text-[var(--color-primary)]'
    );

    card.setAttribute(
      'aria-pressed',
      'true'
    );

  }


  /*
    ============================================================
    SUCCESS STATE
    ============================================================
  */

  function markAsMatched(leftCard, rightCard) {

    const successClasses = [
      'border-[var(--color-success)]',
      'bg-[rgba(34,197,94,0.10)]',
      'text-[var(--color-success)]'
    ];

    successClasses.forEach((className) => {

      leftCard.classList.add(
        className
      );

      rightCard.classList.add(
        className
      );

    });

    leftCard.classList.add(
      'opacity-60',
      'pointer-events-none'
    );

    rightCard.classList.add(
      'opacity-60',
      'pointer-events-none'
    );

    leftCard.disabled = true;
    rightCard.disabled = true;

    leftCard.setAttribute(
      'aria-pressed',
      'false'
    );

    rightCard.setAttribute(
      'aria-pressed',
      'false'
    );

    /*
      Add a small visual check without
      changing the actual puzzle text.
    */

    const leftContent =
      leftCard.querySelector(
        '.card-content'
      );

    const rightContent =
      rightCard.querySelector(
        '.card-content'
      );

    if (leftContent) {

      leftContent.innerHTML =
        `<span class="mr-2 text-[var(--color-success)]" aria-hidden="true">✓</span>${leftContent.textContent}`;

    }

    if (rightContent) {

      rightContent.innerHTML =
        `<span class="mr-2 text-[var(--color-success)]" aria-hidden="true">✓</span>${rightContent.textContent}`;

    }

  }


  /*
    ============================================================
    WRONG MATCH
    ============================================================
  */

  function showWrongMatch() {

    feedback.textContent =
      'Not quite — try another connection.';

    feedback.className =
      'min-h-[28px] text-sm text-[var(--color-danger)]';

  }


  /*
    ============================================================
    COMPLETION REWARD
    ============================================================
  */

  function showCompletionReward() {

    unlockFragment(
      puzzle.fragment
    );

    feedback.innerHTML = `

      <div
        class="space-y-4"
      >

        <div
          class="flex items-center gap-2 text-[var(--color-success)]"
        >
          <span
            class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-[var(--color-success)] bg-[rgba(34,197,94,0.10)]"
            aria-hidden="true"
          >
            ✓
          </span>

          <span>
            All matches completed.
          </span>
        </div>

        <div
          class="card border-[rgba(34,197,94,0.22)] bg-[rgba(34,197,94,0.06)] p-5"
        >

          <div
            class="text-xs uppercase tracking-[0.18em] text-[var(--color-success)]"
          >
            Scripture Revealed
          </div>

          <blockquote
            class="mt-3 text-sm leading-7 text-[var(--color-muted)]"
          >
            “${puzzle.scripture.verse}”
          </blockquote>

          <div
            class="mt-3 text-sm text-[var(--color-primary)]"
          >
            ${puzzle.scripture.reference}
          </div>

          <div
            class="mt-4 text-xs text-[var(--color-muted)]"
          >
            Discovery unlocked.
          </div>

          <button
            type="button"
            class="share-discovery-btn mt-5 inline-flex items-center rounded-xl border border-[rgba(214,179,106,0.12)] bg-[rgba(255,255,255,0.02)] px-4 py-2.5 text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] transition duration-300 hover:border-[rgba(214,179,106,0.24)] hover:text-[var(--color-primary)]"
            data-share-title="First7 Play Recovered Meaning"
            data-share-message="${escapeAttribute(`Recovered Meaning:\n${puzzle.scripture.reference}\n'${puzzle.scripture.verse}'\n\nFirst7 Play - transmitted from the recovered archive.`)}"
          >
            Share Discovery
          </button>

        </div>

      </div>

    `;

  }


  /*
    ============================================================
    ATTRIBUTE ESCAPING
    ============================================================
  */

  function escapeAttribute(value) {

    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('"', '&quot;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;');

  }


  /*
    ============================================================
    LEFT CARD EVENTS
    ============================================================
  */

  leftCards.forEach((card) => {

    card.addEventListener(
      'click',
      () => {

        if (card.disabled)
          return;

        selectLeftCard(card);

        feedback.textContent =
          'Choose the matching answer.';

        feedback.className =
          'min-h-[28px] text-sm text-[var(--color-muted)]';

      }
    );

  });


  /*
    ============================================================
    RIGHT CARD EVENTS
    ============================================================
  */

  rightCards.forEach((card) => {

    card.addEventListener(
      'click',
      () => {

        if (
          !selectedLeft ||
          card.disabled
        ) return;

        const selectedRight =
          card.dataset.value;

        const correctPair =
          puzzle.pairs.find(
            (pair) =>
              pair.left ===
              selectedLeft
          );

        if (
          !correctPair
        ) {

          selectedLeft = null;
          clearLeftSelection();
          return;

        }


        /*
          CORRECT MATCH
        */

        if (
          correctPair.right ===
          selectedRight
        ) {

          matchedCount++;

          const activeLeft =
            Array.from(leftCards).find(
              (c) =>
                c.dataset.value ===
                selectedLeft
            );

          if (activeLeft) {

            markAsMatched(
              activeLeft,
              card
            );

          }

          feedback.textContent =
            '✓ Correct Match';

          feedback.className =
            'min-h-[28px] text-sm font-medium text-[var(--color-success)]';

        }


        /*
          WRONG MATCH
        */

        else {

          showWrongMatch();

        }


        selectedLeft = null;

        clearLeftSelection();

        updateUI();


        /*
          COMPLETED
        */

        if (
          matchedCount ===
          puzzle.pairs.length
        ) {

          showCompletionReward();

        }

      }
    );

  });


  updateUI();

</script>


<script>

  import {
    bindDiscoveryShareButtons
  } from '../../lib/shareDiscovery';

  bindDiscoveryShareButtons({
    selector: '.share-discovery-btn'
  });

</script>
