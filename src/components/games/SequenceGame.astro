---
interface Puzzle {
  title: string;
  fragment?: string;
  sequence?: string[];
  hints?: string[];
  scripture: {
    reference: string;
    verse: string;
  };
}

interface Props {
  puzzles: Puzzle[];
  gameId: string;
}

const {
  puzzles,
  gameId
} = Astro.props as Props;

/*
  Sprint 1:
  one page = one puzzle.
*/

const puzzle = puzzles[0];

const sequence = puzzle.sequence || [];

const shuffled = [...sequence]
  .sort(() => Math.random() - 0.5);
---

<div class="sequence-wrapper">

  <!-- INTRO -->

  <div class="sequence-header">

    <p class="sequence-label">
      Sequence
    </p>

    <h2 class="sequence-title">
      {puzzle.title}
    </h2>

    <p class="sequence-description">
      Place the events, people, ideas, or passages
      in the correct biblical order.
    </p>

    {
      puzzle.hints && puzzle.hints.length > 0 && (
        <div class="hint-box">
          <div class="hint-label">
            Hints
          </div>

          <ul class="hint-list">
            {
              puzzle.hints.map((hint) => (
                <li>{hint}</li>
              ))
            }
          </ul>
        </div>
      )
    }

  </div>


  <!-- STATUS -->

  <div class="sequence-status">

    <div
      id="sequence-count"
      class="status-pill"
      aria-live="polite"
    >
      0 / {sequence.length} placed
    </div>

    <div
      id="sequence-state"
      class="status-pill"
      aria-live="polite"
    >
      Ready
    </div>

  </div>


  <!-- PROGRESS -->

  <div
    id="sequence-progress"
    class="progress-track"
    role="progressbar"
    aria-label="Sequence puzzle progress"
    aria-valuemin="0"
    aria-valuemax={sequence.length}
    aria-valuenow="0"
  >
    <div
      id="sequence-progress-fill"
      class="progress-fill"
      style="width: 0%"
    ></div>
  </div>


  <!-- INSTRUCTION -->

  <p class="sequence-instruction">
    Tap the items in the order you believe is correct.
  </p>


  <!-- BOARD -->

  <div
    id="sequence-board"
    class="sequence-board"
  >

    {
      shuffled.map((item, index) => (

        <button
          type="button"
          class="sequence-card"
          data-value={item}
          aria-pressed="false"
        >

          <span class="sequence-number">
            {index + 1}
          </span>

          <span class="sequence-card-content">
            {item}
          </span>

        </button>

      ))
    }

  </div>


  <!-- CONTROLS -->

  <div class="sequence-controls">

    <button
      id="submit-btn"
      type="button"
      class="game-btn primary"
      disabled
    >
      Check Sequence
    </button>

    <button
      id="reset-btn"
      type="button"
      class="game-btn secondary"
    >
      Reset
    </button>

  </div>


  <!-- FEEDBACK -->

  <div
    id="message"
    class="message"
    aria-live="polite"
    aria-atomic="true"
  ></div>


  <!-- REWARD -->

  <div
    id="reward-box"
    class="reward-box hidden"
  >

    <div class="reward-heading">

      <span
        class="reward-check"
        aria-hidden="true"
      >
        ✓
      </span>

      <div>

        <div class="reward-label">
          Sequence Restored
        </div>

        <div class="reward-title">
          Scripture Revealed
        </div>

      </div>

    </div>

    <h3>
      {puzzle.scripture.reference}
    </h3>

    <blockquote>
      “{puzzle.scripture.verse}”
    </blockquote>

    <p class="reward-note">
      Discovery unlocked.
    </p>

    <button
      id="share-discovery"
      class="share-discovery-btn"
      type="button"
      data-share-title="First7 Play Sacred Order"
      data-share-message={`Sacred Order Restored:\n${sequence.join(' -> ')}\n\n${puzzle.scripture.reference}\n"${puzzle.scripture.verse}"\n\nFirst7 Play - transmitted from the recovered archive.`}
    >
      Share Discovery
    </button>

  </div>

</div>


<script
  define:vars={{
    answer: sequence,
    fragment: puzzle.fragment,
    gameId
  }}
>

  const board =
    document.getElementById(
      'sequence-board'
    );

  const cards = [
    ...document.querySelectorAll(
      '.sequence-card'
    )
  ];

  const submitBtn =
    document.getElementById(
      'submit-btn'
    );

  const resetBtn =
    document.getElementById(
      'reset-btn'
    );

  const message =
    document.getElementById(
      'message'
    );

  const rewardBox =
    document.getElementById(
      'reward-box'
    );

  const sequenceCount =
    document.getElementById(
      'sequence-count'
    );

  const sequenceState =
    document.getElementById(
      'sequence-state'
    );

  const progress =
    document.getElementById(
      'sequence-progress'
    );

  const progressFill =
    document.getElementById(
      'sequence-progress-fill'
    );


  let selected = [];


  /*
    ============================================================
    STORAGE
    ============================================================
  */

  const STORAGE_KEY =
    'first7-progress';

  const FRAGMENTS_KEY =
    'first7-fragments';


  function loadProgress() {

    try {

      const raw =
        localStorage.getItem(
          STORAGE_KEY
        );

      if (!raw) {

        return {
          completed: []
        };

      }

      const parsed =
        JSON.parse(raw);

      if (
        !parsed ||
        !Array.isArray(
          parsed.completed
        )
      ) {

        return {
          completed: []
        };

      }

      return parsed;

    } catch {

      return {
        completed: []
      };

    }

  }


  function saveProgress(data) {

    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(data)
    );

  }


  function markComplete(id) {

    const progressData =
      loadProgress();

    if (
      !progressData.completed.includes(
        id
      )
    ) {

      progressData.completed.push(id);

      saveProgress(
        progressData
      );

    }

  }


  function isComplete(id) {

    return loadProgress()
      .completed
      .includes(id);

  }


  function unlockFragment(fragment) {

    if (!fragment) return;

    let fragments = [];

    try {

      const raw =
        localStorage.getItem(
          FRAGMENTS_KEY
        );

      fragments =
        raw ? JSON.parse(raw) : [];

      if (
        !Array.isArray(fragments)
      ) {

        fragments = [];

      }

    } catch {

      fragments = [];

    }

    if (
      fragments.includes(
        fragment
      )
    ) return;

    fragments.push(
      fragment
    );

    localStorage.setItem(
      FRAGMENTS_KEY,
      JSON.stringify(
        fragments
      )
    );

  }


  /*
    ============================================================
    UI
    ============================================================
  */

  function updateUI() {

    const total =
      answer.length;

    const count =
      selected.length;

    const percentage =
      total > 0
        ? (count / total) * 100
        : 0;

    sequenceCount.textContent =
      `${count} / ${total} placed`;

    if (progress) {

      progress.setAttribute(
        'aria-valuenow',
        String(count)
      );

    }

    if (progressFill) {

      progressFill.style.width =
        `${percentage}%`;

    }

    if (submitBtn) {

      submitBtn.disabled =
        count !== total;

    }

    if (
      count === 0
    ) {

      sequenceState.textContent =
        'Ready';

    } else if (
      count < total
    ) {

      sequenceState.textContent =
        'Building sequence';

    } else {

      sequenceState.textContent =
        'Ready to check';

    }

  }


  /*
    ============================================================
    SELECTION
    ============================================================
  */

  function clearSelection() {

    selected = [];

    cards.forEach(
      (card) => {

        if (
          card.disabled
        ) return;

        card.classList.remove(
          'selected'
        );

        card.setAttribute(
          'aria-pressed',
          'false'
        );

        const number =
          card.querySelector(
            '.sequence-number'
          );

        if (number) {

          number.textContent =
            '';

        }

      }
    );

    updateUI();

  }


  function selectCard(card) {

    if (
      card.disabled
    ) return;

    const value =
      card.dataset.value;

    if (!value) return;

    /*
      Prevent duplicate selection.
    */

    if (
      selected.includes(
        value
      )
    ) return;

    if (
      selected.length >=
      answer.length
    ) return;

    selected.push(
      value
    );

    card.classList.add(
      'selected'
    );

    card.setAttribute(
      'aria-pressed',
      'true'
    );

    const number =
      card.querySelector(
        '.sequence-number'
      );

    if (number) {

      number.textContent =
        String(
          selected.length
        );

    }

    message.textContent =
      '';

    message.className =
      'message';

    updateUI();

  }


  /*
    ============================================================
    CORRECT STATE
    ============================================================
  */

  function showSuccess() {

    cards.forEach(
      (card) => {

        card.disabled = true;

        card.classList.remove(
          'selected'
        );

        card.classList.add(
          'correct'
        );

        card.setAttribute(
          'aria-pressed',
          'false'
        );

        const number =
          card.querySelector(
            '.sequence-number'
          );

        if (number) {

          number.textContent =
            '✓';

        }

      }
    );

    message.textContent =
      '✓ Correct sequence!';

    message.className =
      'message success';

    sequenceState.textContent =
      'Completed';

    /*
      The player has earned the reward.
    */

    rewardBox?.classList.remove(
      'hidden'
    );

    markComplete(
      gameId
    );

    unlockFragment(
      fragment
    );

    updateUI();

  }


  /*
    ============================================================
    WRONG STATE
    ============================================================
  */

  function showWrong() {

    message.textContent =
      'Not quite — try another order.';

    message.className =
      'message error';

    sequenceState.textContent =
      'Try again';

  }


  /*
    ============================================================
    COMPLETION RESTORE
    ============================================================
  */

  function restoreCompletedState() {

    if (
      !isComplete(
        gameId
      )
    ) return;

    cards.forEach(
      (card) => {

        card.disabled = true;

        card.classList.add(
          'correct'
        );

        const number =
          card.querySelector(
            '.sequence-number'
          );

        if (number) {

          number.textContent =
            '✓';

        }

      }
    );

    selected = [
      ...answer
    ];

    message.textContent =
      '✓ Sequence already restored.';

    message.className =
      'message success';

    sequenceState.textContent =
      'Completed';

    rewardBox?.classList.remove(
      'hidden'
    );

    unlockFragment(
      fragment
    );

    updateUI();

  }


  /*
    ============================================================
    CARD CLICK
    ============================================================
  */

  cards.forEach(
    (card) => {

      card.addEventListener(
        'click',
        () => {

          selectCard(
            card
          );

        }
      );

    }
  );


  /*
    ============================================================
    SUBMIT
    ============================================================
  */

  submitBtn?.addEventListener(
    'click',
    () => {

      if (
        selected.length !==
        answer.length
      ) return;

      const correct =
        JSON.stringify(
          selected
        ) ===
        JSON.stringify(
          answer
        );

      if (correct) {

        showSuccess();

      } else {

        showWrong();

      }

    }
  );


  /*
    ============================================================
    RESET
    ============================================================
  */

  resetBtn?.addEventListener(
    'click',
    () => {

      if (
        isComplete(
          gameId
        )
      ) {

        message.textContent =
          'This discovery is already restored.';

        message.className =
          'message success';

        return;

      }

      rewardBox?.classList.add(
        'hidden'
      );

      message.textContent =
        '';

      message.className =
        'message';

      sequenceState.textContent =
        'Ready';

      clearSelection();

    }
  );


  updateUI();

  restoreCompletedState();

</script>


<script>

  import {
    bindDiscoveryShareButtons
  } from '../../lib/shareDiscovery';

  bindDiscoveryShareButtons({
    selector: '#share-discovery'
  });

</script>


