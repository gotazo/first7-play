---
interface Group {
  category: string;
  items: string[];
}

interface Puzzle {
  title: string;

  fragment?: string;

  scripture: {
    reference: string;
    verse: string;
  };

  groups: Group[];
}

const puzzles =
  Astro.props.puzzles as Puzzle[];

/*
  For now:
  one page = one puzzle
*/

const puzzle = puzzles[0];

const groups =
  puzzle.groups || [];

const allItems = groups
  .flatMap((group) =>
    group.items.map((item) => ({
      item,
      group: group.category
    }))
  )
  .sort(() => Math.random() - 0.5);
---

<div class="space-y-10">

  <!-- INTRO -->

  <div class="max-w-2xl space-y-3">

    <p
      class="text-sm uppercase tracking-[0.2em] text-[var(--color-primary)]"
    >
      Connections
    </p>

    <h2
      class="text-3xl font-semibold tracking-tight"
    >
      {puzzle.title}
    </h2>

    <p
      class="text-[var(--color-muted)] leading-7"
    >
      Find 4 connected words that belong together.
      Reveal every hidden scripture category.
    </p>

  </div>

  <!-- STATUS -->

  <div
    class="flex flex-wrap items-center gap-4"
  >

    <div
      id="selection-count"
      class="rounded-full border border-[var(--color-border)] px-4 py-2 text-sm text-[var(--color-muted)]"
    >
      0 / 4 selected
    </div>

    <div
      id="groups-count"
      class="rounded-full border border-[var(--color-border)] px-4 py-2 text-sm text-[var(--color-muted)]"
    >
      0 / {groups.length} groups solved
    </div>

  </div>

  <!-- SOLVED -->

  <div
    id="solved-groups"
    class="space-y-4"
  ></div>

  <!-- BOARD -->

  <div
    class="grid grid-cols-2 gap-4 md:grid-cols-4"
  >

    {
      allItems.map(({ item, group }) => (

        <button
          class="game-card card p-5 text-center font-medium transition duration-200 hover:border-white/20 hover:bg-[var(--color-surface-light)]"
          data-item={item}
          data-group={group}
        >
          {item}
        </button>

      ))
    }

  </div>

  <!-- ACTIONS -->

  <div
    class="flex flex-wrap items-center gap-4"
  >

    <button
      id="submit-btn"
      class="rounded-xl border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-5 py-3 text-sm text-[var(--color-primary)] transition-all duration-300 hover:border-[rgba(214,179,106,0.32)] hover:bg-[rgba(214,179,106,0.12)] disabled:opacity-40"
      disabled
    >
      Submit Group
    </button>

    <button
      id="clear-btn"
      class="rounded-xl border border-[var(--color-border)] px-5 py-3 text-sm text-[var(--color-muted)] transition duration-200 hover:border-white/15"
    >
      Clear Selection
    </button>

  </div>

  <!-- FEEDBACK -->

  <div
    id="feedback"
    class="min-h-[24px] text-sm"
  ></div>

</div>

<script is:inline define:vars={{ puzzle }}>

  const selected = [];

  const solvedGroups =
    new Set();

  const cards =
    document.querySelectorAll(
      '.game-card'
    );

  const submitBtn =
    document.getElementById(
      'submit-btn'
    );

  const clearBtn =
    document.getElementById(
      'clear-btn'
    );

  const feedback =
    document.getElementById(
      'feedback'
    );

  const selectionCount =
    document.getElementById(
      'selection-count'
    );

  const groupsCount =
    document.getElementById(
      'groups-count'
    );

  const solvedGroupsContainer =
    document.getElementById(
      'solved-groups'
    );

  const FRAGMENTS_KEY =
    'first7-fragments';

  function unlockFragment(fragment) {

    if (!fragment) return;

    let fragments = [];

    try {

      const raw =
        localStorage.getItem(
          FRAGMENTS_KEY
        );

      fragments =
        raw ? JSON.parse(raw) : [];

      if (!Array.isArray(fragments)) {
        fragments = [];
      }

    } catch {

      fragments = [];

    }

    if (
      fragments.includes(fragment)
    ) return;

    fragments.push(fragment);

    localStorage.setItem(
      FRAGMENTS_KEY,
      JSON.stringify(fragments)
    );

  }

  function updateUI() {

    selectionCount.textContent =
      `${selected.length} / 4 selected`;

    groupsCount.textContent =
      `${solvedGroups.size} / ${(puzzle.groups || []).length} groups solved`;

    submitBtn.disabled =
      selected.length !== 4;

  }

  function clearSelection() {

    selected.length = 0;

    cards.forEach((card) => {

      card.classList.remove(
        'border-[var(--color-primary)]',
        'bg-[rgba(214,179,106,0.12)]',
        'text-[var(--color-primary)]'
      );

    });

    feedback.textContent = '';

    updateUI();

  }

  function escapeAttribute(value) {

    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('"', '&quot;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;');

  }

  cards.forEach((card) => {

    card.addEventListener('click', () => {

      if (card.disabled) return;

      const item =
        card.dataset.item;

      const index =
        selected.indexOf(item);

      if (index > -1) {

        selected.splice(index, 1);

        card.classList.remove(
          'border-[var(--color-primary)]',
          'bg-[rgba(214,179,106,0.12)]',
          'text-[var(--color-primary)]'
        );

      } else {

        if (selected.length >= 4)
          return;

        selected.push(item);

        card.classList.add(
          'border-[var(--color-primary)]',
          'bg-[rgba(214,179,106,0.12)]',
          'text-[var(--color-primary)]'
        );

      }

      updateUI();

    });

  });

  clearBtn.addEventListener(
    'click',
    clearSelection
  );

  submitBtn.addEventListener(
    'click',
    () => {

      const selectedCards =
        Array.from(cards).filter(
          (card) =>
            selected.includes(
              card.dataset.item
            )
        );

      const groups = [
        ...new Set(
          selectedCards.map(
            (card) =>
              card.dataset.group
          )
        )
      ];

      if (groups.length === 1) {

        const solvedGroup =
          groups[0];

        const discoveredItems =
          [...selected];

        solvedGroups.add(
          solvedGroup
        );

        feedback.textContent =
          `✓ Correct — ${solvedGroup}`;

        feedback.className =
          'text-sm text-[var(--color-success)]';

        const solvedCard =
          document.createElement('div');

        solvedCard.className =
          'card p-5 border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.06)]';

        solvedCard.innerHTML = `

<div class="space-y-4">

  <div>

    <div class="text-sm uppercase tracking-[0.18em] text-[var(--color-primary)] mb-3">
      ${solvedGroup}
    </div>

    <div class="flex flex-wrap gap-2 text-sm text-[var(--color-text)]">
      ${discoveredItems.join(', ')}
    </div>

    <button
      type="button"
      class="share-discovery-btn mt-5 inline-flex items-center rounded-xl border border-[rgba(214,179,106,0.12)] bg-[rgba(255,255,255,0.02)] px-4 py-2.5 text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] transition duration-300 hover:border-[rgba(214,179,106,0.24)] hover:text-[var(--color-primary)]"
      data-share-title="First7 Play Scripture Connection"
      data-share-message="${escapeAttribute(`Recovered Scripture Connection:\n'${solvedGroup}: ${discoveredItems.join(' / ')}'\n\nFirst7 Play - transmitted from the recovered archive.`)}"
    >
      Share Discovery
    </button>

  </div>

</div>

`;

        solvedGroupsContainer
          .appendChild(
            solvedCard
          );

        selectedCards.forEach(
          (card) => {

            card.disabled = true;

            card.classList.add(
              'opacity-40',
              'pointer-events-none'
            );

          }
        );

        clearSelection();

        updateUI();

        if (
          solvedGroups.size ===
          (puzzle.groups || []).length
        ) {

          unlockFragment(
            puzzle.fragment
          );

          feedback.innerHTML = `

<div class="space-y-4">

  <div class="text-[var(--color-success)]">
    🎉 All scripture groups discovered.
  </div>

  <div class="card p-5 border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.06)]">

    <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] mb-3">
      Scripture Revealed
    </div>

    <blockquote class="text-sm leading-7 text-[var(--color-muted)]">
      “${puzzle.scripture.verse}”
    </blockquote>

    <div class="mt-3 text-sm text-[var(--color-primary)]">
      ${puzzle.scripture.reference}
    </div>

  </div>

</div>

`;

        }

      } else {

        feedback.textContent =
          'Not quite. Those words do not belong together.';

        feedback.className =
          'text-sm text-[var(--color-danger)]';

      }

    }
  );

  updateUI();

</script>

<script>
  import { bindDiscoveryShareButtons } from '../../lib/shareDiscovery';

  bindDiscoveryShareButtons({
    selector: '.share-discovery-btn'
  });
</script>
