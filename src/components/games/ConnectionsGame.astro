---
interface Puzzle {
  title: string;
  items: string[];
}

const puzzles = Astro.props.puzzles as Puzzle[];

const allItems = puzzles
  .flatMap((group) =>
    group.items.map((item) => ({
      item,
      group: group.title
    }))
  )
  .sort(() => Math.random() - 0.5);
---

<div class="space-y-10">

  <!-- RULES -->
  <div class="max-w-2xl space-y-3">

    <p class="text-sm uppercase tracking-[0.2em] text-[var(--color-primary)]">
      How To Play
    </p>

    <p class="text-[var(--color-muted)] leading-7">
      Find 4 connected words that belong together.
      Select four cards and uncover every hidden scripture group.
    </p>

  </div>

  <!-- GAME STATUS -->
  <div class="flex flex-wrap items-center gap-4">

    <div
      id="selection-count"
      class="rounded-full border border-[var(--color-border)] px-4 py-2 text-sm text-[var(--color-muted)]"
    >
      0 / 4 selected
    </div>

    <div
      id="groups-count"
      class="rounded-full border border-[var(--color-border)] px-4 py-2 text-sm text-[var(--color-muted)]"
    >
      0 / {puzzles.length} groups solved
    </div>

  </div>

  <!-- SOLVED GROUPS -->
  <div
    id="solved-groups"
    class="space-y-4"
  ></div>

  <!-- GAME BOARD -->
  <div
    id="game-board"
    class="grid grid-cols-2 md:grid-cols-4 gap-4"
  >

    {allItems.map(({ item, group }) => (

      <button
        class="game-card card p-5 text-center font-medium transition duration-200 hover:border-white/20 hover:bg-[var(--color-surface-light)]"
        data-item={item}
        data-group={group}
      >
        {item}
      </button>

    ))}

  </div>

  <!-- ACTIONS -->
  <div class="flex flex-wrap items-center gap-4">

    <button
      id="submit-btn"
      class="rounded-xl border border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.08)] px-5 py-3 text-sm text-[var(--color-primary)] transition-all duration-300 hover:border-[rgba(214,179,106,0.32)] hover:bg-[rgba(214,179,106,0.12)] disabled:opacity-40"
      disabled
    >
      Submit Group
    </button>

    <button
      id="clear-btn"
      class="rounded-xl border border-[var(--color-border)] px-5 py-3 text-sm text-[var(--color-muted)] transition duration-200 hover:border-white/15"
    >
      Clear Selection
    </button>

  </div>

  <!-- FEEDBACK -->
  <div
    id="feedback"
    class="min-h-[24px] text-sm"
  ></div>

</div>

<script is:inline define:vars={{ puzzles }}>

  const selected = [];
  const solvedGroups = new Set();

  const cards = document.querySelectorAll('.game-card');

  const submitBtn = document.getElementById('submit-btn');
  const clearBtn = document.getElementById('clear-btn');

  const feedback = document.getElementById('feedback');

  const selectionCount = document.getElementById('selection-count');
  const groupsCount = document.getElementById('groups-count');

  const solvedGroupsContainer =
    document.getElementById('solved-groups');

  function updateUI() {

    selectionCount.textContent =
      `${selected.length} / 4 selected`;

    groupsCount.textContent =
      `${solvedGroups.size} / ${puzzles.length} groups solved`;

    submitBtn.disabled = selected.length !== 4;

  }

  function clearSelection() {

    selected.length = 0;

    cards.forEach((card) => {
      card.classList.remove(
        'border-[var(--color-primary)]',
        'bg-[rgba(214,179,106,0.12)]',
        'text-[var(--color-primary)]'
      );
    });

    feedback.textContent = '';

    updateUI();

  }

  cards.forEach((card) => {

    card.addEventListener('click', () => {

      if (card.disabled) return;

      const item = card.dataset.item;

      const index = selected.indexOf(item);

      if (index > -1) {

        selected.splice(index, 1);

        card.classList.remove(
          'border-[var(--color-primary)]',
          'bg-[rgba(214,179,106,0.12)]',
          'text-[var(--color-primary)]'
        );

      } else {

        if (selected.length >= 4) return;

        selected.push(item);

        card.classList.add(
          'border-[var(--color-primary)]',
          'bg-[rgba(214,179,106,0.12)]',
          'text-[var(--color-primary)]'
        );

      }

      updateUI();

    });

  });

  clearBtn.addEventListener('click', clearSelection);

  submitBtn.addEventListener('click', () => {

    const selectedCards =
      Array.from(cards).filter((card) =>
        selected.includes(card.dataset.item)
      );

    const groups =
      [...new Set(
        selectedCards.map((card) => card.dataset.group)
      )];

    if (groups.length === 1) {

      const solvedGroup = groups[0];

      const solvedPuzzle =
  puzzles.find(
    (p) => p.title === solvedGroup
  );

      solvedGroups.add(solvedGroup);

      feedback.textContent =
        `✓ Correct — ${solvedGroup}`;

      feedback.className =
        'text-sm text-[var(--color-success)]';

      const solvedCard = document.createElement('div');

      solvedCard.className =
        'card p-5 border-[rgba(214,179,106,0.18)] bg-[rgba(214,179,106,0.06)]';

      solvedCard.innerHTML = `

  <div class="space-y-4">

    <div>

      <div class="text-sm uppercase tracking-[0.18em] text-[var(--color-primary)] mb-3">
        ${solvedGroup}
      </div>

      <div class="flex flex-wrap gap-2 text-sm text-[var(--color-text)]">
        ${selected.join(', ')}
      </div>

    </div>

    <div class="border-t border-[var(--color-border)] pt-4">

      <div class="text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] mb-2">
        Scripture Revealed
      </div>

      <blockquote class="text-sm leading-7 text-[var(--color-muted)]">
        “${solvedPuzzle.scripture.verse}”
      </blockquote>

      <div class="mt-3 text-sm text-[var(--color-primary)]">
        ${solvedPuzzle.scripture.reference}
      </div>

    </div>

  </div>

`;

      solvedGroupsContainer.appendChild(solvedCard);

      selectedCards.forEach((card) => {

        card.disabled = true;

        card.classList.add(
          'opacity-40',
          'pointer-events-none'
        );

      });

      clearSelection();

      updateUI();

      if (solvedGroups.size === puzzles.length) {

        feedback.textContent =
          '🎉 All scripture groups discovered.';

      }

    } else {

      feedback.textContent =
        'Not quite. Those words do not belong together.';

      feedback.className =
        'text-sm text-[var(--color-danger)]';

      selectedCards.forEach((card) => {

        card.animate(
          [
            { transform: 'translateX(0px)' },
            { transform: 'translateX(-4px)' },
            { transform: 'translateX(4px)' },
            { transform: 'translateX(0px)' }
          ],
          {
            duration: 250
          }
        );

      });

    }

  });

  updateUI();

</script>
