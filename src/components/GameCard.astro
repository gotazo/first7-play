---
interface Props {
  title: string;
  description: string;
  href: string;
  status?: string;
}

const {
  title,
  description,
  href,
  status = "Play"
} = Astro.props;
---

<a href={href} class="group block">
  <article class="card glow p-6 transition duration-300 hover:-translate-y-1 hover:border-white/15">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h3 class="text-xl font-semibold tracking-tight">
          {title}
        </h3>

        <p class="mt-3 text-sm leading-6 text-[var(--color-muted)] max-w-md">
          {description}
        </p>
      </div>

      <div class="text-sm text-[var(--color-primary)] opacity-70 group-hover:opacity-100 transition-opacity">
        {status}
      </div>
    </div>
  </article>
</a>