---
import PlayNavbar from "../components/PlayNavbar.astro";
import PlayFooter from "../components/PlayFooter.astro";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "First7 Play",
  description =
    "Interactive Bible games and scripture discovery experiences."
} = Astro.props;
---

<!doctype html>

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-PFEQJT54SL"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('js', new Date());

      gtag('config', 'G-PFEQJT54SL');
    </script>

  </head>

  <body>

    <PlayNavbar />

    <main>
      <slot />
    </main>

    <PlayFooter />

  </body>

</html>