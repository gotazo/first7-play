---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "First7 Play",
  description = "Interactive Bible games and scripture discovery experiences."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <slot />
  </body>
</html>